---
import BaseLayout from '../layouts/BaseLayout.astro';
import LogoHero from '../components/logo/LogoHero.astro';
import Meaning from '../components/logo/Meaning.astro';
import Genesis from '../components/logo/Genesis.astro';
import Blueprint from '../components/logo/Blueprint.astro';
import Perception from '../components/logo/Perception.astro';
import Dimension from '../components/logo/Dimension.astro';
import System from '../components/logo/System.astro';
import Closing from '../components/logo/Closing.astro';
import { webPageSchema } from '../lib/schema';

const title = 'The Rachna mark';
const description = 'The meaning, geometry and psychology behind the Rachna Labs logo: a leaf that ends in a pen nib, drawn as one line.';
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const jsonLd = [webPageSchema(siteUrl, new URL('/logo', siteUrl).href, title, description)];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <LogoHero />
  <Meaning />
  <Genesis />
  <Blueprint />
  <Perception />
  <Dimension />
  <System />
  <Closing />
</BaseLayout>

<style is:global>
  /* The hero mark draws itself from the tip of the leaf: leaf, then axis, then nib. */
  @media (prefers-reduced-motion: no-preference) {
    .js .draw {
      stroke-dasharray: 1 1;
      stroke-dashoffset: 1;
      animation: mark-draw 2s cubic-bezier(0.65, 0, 0.35, 1) 0.5s forwards;
    }
    .js .draw-vein {
      animation-duration: 1.3s;
      animation-delay: 1.9s;
    }
    .js .draw-nib {
      opacity: 0;
      animation: mark-fade 0.9s ease 2.9s forwards;
    }
    .js .construct {
      opacity: 0;
      animation: mark-fade 1.4s ease 0.1s forwards;
    }
    .js .construct.labels {
      animation-delay: 2.6s;
    }
  }
  @keyframes mark-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes mark-fade {
    to {
      opacity: 1;
    }
  }
</style>

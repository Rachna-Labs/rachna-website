---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you are looking for does not exist or has moved." noindex>
  <section class="container-x flex min-h-[72vh] flex-col items-center justify-center py-24 text-center">
    <p lang="hi" class="font-rozha text-7xl text-blue">रचना</p>
    <p class="mt-8 text-sm text-muted-foreground">Error 404</p>
    <h1 class="mt-2 font-display text-5xl tracking-[-0.04em] text-ink sm:text-7xl">This page doesn’t exist.</h1>
    <p class="mt-5 max-w-md text-base leading-relaxed text-muted-foreground">The link may be broken or the page may have moved.</p>
    <div class="mt-9 flex flex-col gap-3 sm:flex-row">
      <a href="/" class="btn btn-primary btn-lg">Back to home</a>
      <a href="/#contact" class="btn btn-secondary btn-lg">Contact us</a>
    </div>
  </section>
</BaseLayout>

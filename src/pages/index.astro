---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Why from '../components/home/Why.astro';
import Method from '../components/home/Method.astro';
import Research from '../components/home/Research.astro';
import Apps from '../components/home/Apps.astro';
import Principles from '../components/home/Principles.astro';
import Work from '../components/home/Work.astro';
import FAQ from '../components/home/FAQ.astro';
import Contact from '../components/home/Contact.astro';
import { site } from '../config/site';
import { faqs } from '../data/faqs';
import { products } from '../data/products';
import { faqSchema, productsSchema, webPageSchema } from '../lib/schema';

const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const jsonLd = [
  webPageSchema(siteUrl, siteUrl.href, site.title, site.description),
  productsSchema(siteUrl, products),
  faqSchema(faqs),
];
---

<BaseLayout jsonLd={jsonLd}>
  <Hero />
  <Why />
  <Method />
  <Research />
  <Apps />
  <Principles />
  <Work />
  <FAQ />
  <Contact />
</BaseLayout>

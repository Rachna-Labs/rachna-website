---
import BaseLayout from './BaseLayout.astro';
import { site, legalLinks } from '../config/site';
import { breadcrumbSchema, webPageSchema } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  summary: string;
  toc: { id: string; label: string }[];
}

const { title, description, summary, toc } = Astro.props;

const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;
const jsonLd = [
  webPageSchema(siteUrl, pageUrl, title, description),
  breadcrumbSchema([
    { name: 'Home', url: siteUrl.href },
    { name: title, url: pageUrl },
  ]),
];
const current = Astro.url.pathname;
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <section class="relative overflow-hidden border-b border-border">
    <div class="relative">
    <div class="container-x relative py-14 sm:py-20">
      <nav aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-2 text-xs font-medium text-muted-foreground">
          <li><a href="/" class="transition-colors hover:text-ink">Home</a></li>
          <li aria-hidden="true" class="text-ink/30">/</li>
          <li>Legal</li>
          <li aria-hidden="true" class="text-ink/30">/</li>
          <li aria-current="page" class="text-ink">{title}</li>
        </ol>
      </nav>
      <h1 class="mt-5 font-display text-4xl tracking-[-0.04em] text-ink sm:text-6xl">{title}</h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted-foreground sm:text-lg">{summary}</p>
      <p class="mt-6 inline-flex items-center gap-2 rounded-[4px] border border-line bg-panel px-3 py-1.5 text-xs text-graphite">
        <span class="size-1.5 rounded-full bg-mehendi"></span>
        Last updated: {site.legalLastUpdated}
      </p>
    </div>
    </div>
  </section>

  <div class="container-x grid gap-12 py-14 lg:grid-cols-[230px_minmax(0,1fr)] lg:gap-16 lg:py-20">
    <aside class="order-last lg:sticky lg:top-24 lg:order-none lg:self-start">
      <nav aria-label="On this page" class="hidden lg:block">
        <p class="text-[13px] font-medium text-ink">On this page</p>
        <ol class="mt-3 grid gap-0.5">
          {
            toc.map((item) => (
              <li>
                <a
                  href={`#${item.id}`}
                  class="block rounded-xl px-3 py-1.5 text-sm text-muted-foreground transition-colors hover:bg-mist hover:text-ink"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
      <div class="panel p-4 lg:mt-10">
        <p class="px-3 text-[13px] font-medium text-ink">Policies</p>
        <ul class="mt-3 space-y-0.5">
          {
            legalLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={current === link.href ? 'page' : undefined}
                  class:list={[
                    'flex items-center gap-2 rounded-xl px-3 py-2 text-sm transition-colors',
                    current === link.href ? 'bg-surface font-medium text-ink' : 'text-muted-foreground hover:bg-surface hover:text-ink',
                  ]}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </aside>

    <article class="prose-legal max-w-3xl">
      <slot />
    </article>
  </div>
</BaseLayout>

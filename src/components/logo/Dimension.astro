---
import MarkG from './MarkG.astro';
import { mark } from '../../lib/mark';

/*
 * The mark as an object: built from the same dots as the sphere on the home page, given
 * depth, and turning slowly. Below it, the mark seen from seven angles; at 90° only the
 * axis is left.
 */
const angles = [0, 15, 30, 45, 60, 75, 90];
---

<section id="dimension" class="scroll-mt-20 border-t border-line py-20 sm:py-28">
  <div class="container-x">
    <div class="grid items-center gap-12 px-2 sm:px-6 lg:grid-cols-[1fr_1.2fr] lg:px-10">
      <div data-reveal>
        <p class="font-mono text-[12px] tracking-[0.12em] text-muted-foreground uppercase">E · Dimension</p>
        <h2 class="mt-5 font-display text-[2.4rem] leading-[1.08] font-light tracking-[-0.035em] sm:text-[3.2rem]">One mark, <span class="accent-italic">every angle</span></h2>
        <p class="mt-6 max-w-md text-[16px] leading-relaxed text-muted-foreground">
          Drawn in dots, the same way we draw the lab's sphere, the mark becomes an object you can turn. From every side it keeps its character. Turn it all the way and one thing remains: the line.
        </p>
        <p class="mt-6 max-w-md text-[15px] leading-relaxed text-graphite">
          That line is the part we never change. Products, colours and screens move around it; the method stays.
        </p>
      </div>

      <div class="relative h-[460px] sm:h-[560px]" data-reveal style="--reveal-delay: 120ms">
        <div class="dots fade-dots absolute inset-0"></div>
        <canvas data-mark-dots class="absolute inset-0 size-full" aria-label="The mark in dots, turning slowly" role="img"></canvas>
        <svg class="pointer-events-none absolute size-0" aria-hidden="true">
          <path data-sample="leaf" d={mark.leafRight} />
          <path data-sample="leaf" d={mark.leafLeft} />
          <path data-sample="vein" d={mark.vein} />
        </svg>
      </div>
    </div>

    <ol class="mt-16 grid grid-cols-4 gap-y-10 border-t border-line px-2 pt-10 sm:grid-cols-7 sm:px-6 lg:px-10" data-reveal>
      {
        angles.map((a) => (
          <li class="flex flex-col items-center">
            <svg viewBox="-40 -10 381 548" class="h-28 w-auto sm:h-36" fill="none" aria-hidden="true">
              <line x1={mark.axis} y1={0} x2={mark.axis} y2={528} stroke="#E2E2E2" stroke-dasharray="6 8" />
              {a < 90 ? (
                <MarkG transform={`translate(${mark.axis} 0) scale(${Math.cos((a * Math.PI) / 180).toFixed(4)} 1) translate(${-mark.axis} 0)`} />
              ) : (
                <line x1={mark.axis} y1={0} x2={mark.axis} y2={524} stroke="#111111" stroke-width="10" stroke-linecap="round" />
              )}
            </svg>
            <span class="mt-4 font-mono text-[12px] text-muted-foreground">{a}°</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script>
  import { mark } from '../../lib/mark';

  const canvas = document.querySelector<HTMLCanvasElement>('[data-mark-dots]');
  const ctx = canvas?.getContext('2d');

  if (canvas && ctx) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    type P = { x: number; y: number; z: number; accent: boolean };
    const pts: P[] = [];
    const cx = mark.axis;
    const cy = mark.height / 2;
    const half = mark.stroke / 2;
    const depths = [-18, 0, 18];

    // The leaf and the axis: dots across the width of each stroke, along its length.
    document.querySelectorAll<SVGPathElement>('[data-sample]').forEach((path) => {
      const total = path.getTotalLength();
      const step = 5.5;
      for (let s = 0; s <= total; s += step) {
        const a = path.getPointAtLength(Math.max(0, s - 1));
        const b = path.getPointAtLength(Math.min(total, s + 1));
        const p = path.getPointAtLength(s);
        const len = Math.hypot(b.x - a.x, b.y - a.y) || 1;
        const nx = -(b.y - a.y) / len;
        const ny = (b.x - a.x) / len;
        for (const o of [-half * 0.8, -half * 0.27, half * 0.27, half * 0.8]) {
          for (const z of depths) pts.push({ x: p.x + nx * o - cx, y: p.y + ny * o - cy, z, accent: Math.random() < 0.04 });
        }
      }
    });
    // The nib: one filled diamond.
    const { nib } = mark;
    const hw = (nib.right - nib.left) / 2;
    const mid = nib.mid;
    const hh = mid - nib.apex;
    for (let y = nib.apex; y <= nib.tip; y += 8) {
      for (let x = nib.left; x <= nib.right; x += 8) {
        if (Math.abs(x - nib.x) / hw + Math.abs(y - mid) / hh > 1) continue;
        for (const z of depths) pts.push({ x: x - cx, y: y - cy, z, accent: Math.random() < 0.04 });
      }
    }

    let w = 0;
    let h = 0;
    let k = 1;
    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = canvas.clientWidth;
      h = canvas.clientHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      k = Math.min((h * 0.78) / mark.height, (w * 0.8) / mark.width);
    };

    let pointer = 0;
    let eased = 0;
    canvas.addEventListener('pointermove', (e) => {
      const r = canvas.getBoundingClientRect();
      pointer = ((e.clientX - r.left) / r.width - 0.5) * 1.2;
    });
    canvas.addEventListener('pointerleave', () => (pointer = 0));

    const draw = (time: number) => {
      ctx.clearRect(0, 0, w, h);
      eased += (pointer - eased) * 0.05;
      const a = Math.sin(time * 0.00032) * 1.05 + eased;
      const tilt = Math.sin(time * 0.00021) * 0.12;
      const ca = Math.cos(a);
      const sa = Math.sin(a);
      const ct = Math.cos(tilt);
      const st = Math.sin(tilt);
      for (const p of pts) {
        const x1 = p.x * ca + p.z * sa;
        const z1 = -p.x * sa + p.z * ca;
        const y2 = p.y * ct - z1 * st;
        const z2 = p.y * st + z1 * ct;
        const persp = 900 / (900 - z2);
        const px = w / 2 + x1 * k * persp;
        const py = h / 2 + y2 * k * persp;
        const depth = Math.min(1, Math.max(0, (z2 + 60) / 120));
        const size = 1 + depth * 0.9;
        ctx.globalAlpha = 0.3 + depth * 0.6;
        ctx.fillStyle = p.accent ? '#000000' : '#4A4A4A';
        ctx.fillRect(px - size / 2, py - size / 2, size, size);
      }
      ctx.globalAlpha = 1;
    };

    let frame = 0;
    let running = false;
    const loop = (time: number) => {
      draw(time);
      if (running) frame = requestAnimationFrame(loop);
    };
    resize();
    draw(0);
    new ResizeObserver(() => {
      resize();
      draw(performance.now());
    }).observe(canvas);
    new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting && !reduce && !running) {
        running = true;
        frame = requestAnimationFrame(loop);
      } else if (!entry.isIntersecting) {
        running = false;
        cancelAnimationFrame(frame);
      }
    }).observe(canvas);
  }
</script>

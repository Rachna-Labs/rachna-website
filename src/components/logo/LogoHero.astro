---
import { PenTool, RotateCcw } from '@lucide/astro';
import { mark, facts } from '../../lib/mark';

/*
 * The mark is drafted in front of you: guides, then compass work, then a pencil line from
 * the tip of the leaf that ink swells to full weight, then the measurements. Built on the
 * axis, the ellipse of the leaf's lower half, the tangents that meet at the tip, and the
 * box and diagonal of the nib's diamond.
 *
 * Everything inside the group is in the mark's own units (301 × 528), placed on a
 * 1200 × 680 stage.
 */
const { axis, apex, widest, base, rx, ry, nib, stroke } = mark;
const ox = 600 - axis;
const oy = 70;

// Unit direction of the tangents at the tip of the leaf.
const tx = 130.28 / Math.hypot(130.28, 132.134);
const ty = 132.134 / Math.hypot(130.28, 132.134);
const arc = 120;

const chapters = [
  { id: 'meaning', letter: 'A', label: 'Meaning' },
  { id: 'genesis', letter: 'B', label: 'Genesis' },
  { id: 'geometry', letter: 'C', label: 'Geometry' },
  { id: 'perception', letter: 'D', label: 'Perception' },
  { id: 'dimension', letter: 'E', label: 'Dimension' },
  { id: 'system', letter: 'F', label: 'System' },
];
---

<section class="relative overflow-hidden">
  <div class="container-text pt-20 text-center sm:pt-28">
    <p class="chip"><span class="chip-icon"><PenTool class="size-3.5" /></span>The Rachna mark</p>
    <h1 class="mx-auto mt-7 max-w-3xl font-display text-[2.6rem] leading-[1.08] font-light tracking-[-0.035em] text-ink sm:text-[3.5rem] lg:text-[4rem]">
      A leaf that learned to <span class="accent-italic">write</span>
    </h1>
    <p class="mx-auto mt-6 max-w-xl text-[16px] leading-relaxed text-muted-foreground">
      Our mark is one line. It begins as a leaf, the life we study, and ends as a pen nib, the work we write and build. This is the thinking behind it: its meaning, its geometry and how the mind reads it.
    </p>
  </div>

  <div class="relative mx-auto mt-6 max-w-[1200px]">
    <div class="blueprint bp-play relative h-[560px] sm:aspect-[1200/680] sm:h-auto" data-blueprint aria-hidden="true">
      <div class="dots fade-dots absolute inset-0"></div>
      <svg viewBox="0 0 1200 680" preserveAspectRatio="xMidYMid slice" class="absolute inset-0 size-full" fill="none">
        <g transform={`translate(${ox} ${oy})`}>
          <!-- 1. Guides: the four levels sweep in, the axis drops from above -->
          <g stroke-width="1" vector-effect="non-scaling-stroke">
            {[apex, widest, base, nib.tip].map((y, i) => <line class="bp-sweep" style={`--d:${i * 0.05}s`} x1={-260} y1={y} x2={560} y2={y} stroke="#E4E4E4" stroke-dasharray="2 6" />)}
            <line class="bp-drop" style="--d:0.07s" x1={axis} y1={-60} x2={axis} y2={600} stroke="#D6D6D6" stroke-dasharray="4 6" />
          </g>

          <!-- 2. Construction: compass and straight edge -->
          <g stroke="#DEDEDE" stroke-width="1" vector-effect="non-scaling-stroke">
            <line class="bp-draw" style="--d:0.2s;--t:0.65s" pathLength="1" x1={axis} y1={apex} x2={axis - tx * 300} y2={apex + ty * 300} />
            <line class="bp-draw" style="--d:0.2s;--t:0.65s" pathLength="1" x1={axis} y1={apex} x2={axis + tx * 300} y2={apex + ty * 300} />
            <path class="bp-draw" style="--d:0.26s;--t:0.91s" pathLength="1" d={`M${axis} ${widest - ry} A${rx} ${ry} 0 1 1 ${axis - 0.01} ${widest - ry}`} />
            <path class="bp-draw" style="--d:0.39s;--t:0.78s" pathLength="1" d={`M${nib.x} ${nib.apex}H${nib.right}V${nib.tip}H${nib.left}V${nib.apex}Z`} />
            <line class="bp-draw" style="--d:0.59s;--t:0.52s" pathLength="1" x1={nib.left - 40} y1={nib.mid} x2={nib.right + 40} y2={nib.mid} />
          </g>

          <!-- 3. The mark: a pencil line from the tip, then ink fills it to full weight -->
          <g stroke="#111111" stroke-linecap="round" stroke-linejoin="round">
            <path class="mk-line" style="--d:0.45s;--t:1.04s;--i:1.56s" pathLength="1" d={mark.leafRight} stroke-width={stroke} />
            <path class="mk-line" style="--d:0.45s;--t:1.04s;--i:1.56s" pathLength="1" d={mark.leafLeft} stroke-width={stroke} />
            <path class="mk-line" style="--d:0.78s;--t:0.72s;--i:1.62s" pathLength="1" d={mark.vein} stroke-width={stroke} />
          </g>
          <!-- The nib: traced in pencil, then ink flows down into it from the leaf -->
          <g stroke="#111111" stroke-width="1.6" stroke-linejoin="round">
            <path class="bp-draw" style="--d:1.23s;--t:0.52s" pathLength="1" d={mark.nibRight} />
            <path class="bp-draw" style="--d:1.23s;--t:0.52s" pathLength="1" d={mark.nibLeft} />
          </g>
          <clipPath id="nib-flow">
            <rect class="nib-flow" style="--d:1.76s" x={nib.left - 10} y={nib.apex - 10} width={nib.right - nib.left + 20} height={nib.tip - nib.apex + 20} />
          </clipPath>
          <g clip-path="url(#nib-flow)" fill="#111111" stroke="#111111" stroke-width={mark.nibStroke}>
            <path d={mark.nibPath} />
          </g>

          <!-- 4. Measurements -->
          <path class="bp-draw" style="--d:1.95s;--t:0.52s" pathLength="1" d={`M${axis - tx * arc} ${apex + ty * arc} A${arc} ${arc} 0 0 0 ${axis + tx * arc} ${apex + ty * arc}`} stroke="#9A9A9A" vector-effect="non-scaling-stroke" />
          <g stroke="#9A9A9A" stroke-width="1" vector-effect="non-scaling-stroke">
            <g class="bp-grow" style="--d:2.04s">
              <line x1={-80} y1={apex} x2={-80} y2={base} />
              {[apex, widest, base].map((y) => <line x1={-88} y1={y} x2={-72} y2={y} />)}
            </g>
            <g class="bp-grow" style="--d:1.95s">
              <line x1={0} y1={-30} x2={300.6} y2={-30} />
              {[0, 300.6].map((x) => <line x1={x} y1={-38} x2={x} y2={-22} />)}
            </g>
            <g class="bp-grow" style="--d:2.13s">
              <line x1={400} y1={apex} x2={400} y2={base} />
              {[apex, base].map((y) => <line x1={392} y1={y} x2={408} y2={y} />)}
            </g>
            <g class="bp-grow" style="--d:2.22s">
              <line x1={428} y1={nib.apex} x2={428} y2={nib.tip} />
              {[nib.apex, nib.tip].map((y) => <line x1={420} y1={y} x2={436} y2={y} />)}
            </g>
            <g class="bp-grow" style="--d:2.18s">
              <line x1={0} y1={widest + 52} x2={stroke} y2={widest + 52} />
              {[0, stroke].map((x) => <line x1={x} y1={widest + 46} x2={x} y2={widest + 58} />)}
            </g>
          </g>

          <g class="font-mono" fill="#8A8A8A" font-size="11" letter-spacing="0.06em">
            {[['APEX', apex], ['WIDEST', widest], ['BASE', base], ['NIB', nib.tip]].map(([t, y], i) => (
              <text class="bp-rise" style={`--d:${0.13 + i * 0.05}s`} x={-260} y={(y as number) - 8}>{t}</text>
            ))}
            <text class="bp-rise" style="--d:2.08s" x={axis + 92} y={apex + 24}><tspan data-count={facts.apexAngle.toFixed(1)} data-dec="1">{facts.apexAngle.toFixed(1)}</tspan>°</text>
            <text class="bp-rise" style="--d:1.99s" x={150.3} y={-44} text-anchor="middle"><tspan data-count="300.6" data-dec="1">300.6</tspan> = 7.5x</text>
            <text class="bp-rise" style="--d:2.13s" x={-98} y={(apex + widest) / 2 + 4} text-anchor="end">a</text>
            <text class="bp-rise" style="--d:2.18s" x={-98} y={(widest + base) / 2 + 4} text-anchor="end">b</text>
            <text class="bp-rise" style="--d:2.27s" x={-98} y={base + 34} text-anchor="end">a : b = 1 : <tspan data-count={facts.leafRatio.toFixed(2)} data-dec="2">{facts.leafRatio.toFixed(2)}</tspan></text>
            <text class="bp-rise" style="--d:2.37s" x={-98} y={base + 52} text-anchor="end">φ = 1.618</text>
            <text class="bp-rise" style="--d:2.41s" x={-98} y={nib.mid + 4} text-anchor="end">one diamond · 9 : 5</text>
            <text class="bp-rise" style="--d:2.22s" x={20} y={widest + 76} text-anchor="middle">x</text>
            <text class="bp-rise" style="--d:2.27s" x={448} y={(apex + base) / 2 + 4}>5</text>
            <text class="bp-rise" style="--d:2.37s" x={448} y={(nib.apex + nib.tip) / 2 + 4}>3</text>
          </g>
        </g>
      </svg>
    </div>
    <button type="button" data-replay class="replay absolute right-4 bottom-6 inline-flex items-center gap-1.5 font-mono text-[11px] tracking-[0.06em] text-muted-foreground uppercase transition-colors hover:text-ink sm:right-6">
      <RotateCcw class="size-3.5" /> Draw again
    </button>
  </div>

  <nav aria-label="Chapters" class="container-x relative">
    <ol class="grid grid-cols-3 border-t border-line sm:grid-cols-6">
      {
        chapters.map((c) => (
          <li>
            <a href={`#${c.id}`} class="group flex items-baseline gap-2 px-2 py-5 text-[14px] text-graphite transition-colors hover:text-ink sm:px-4">
              <span class="font-mono text-[12px] text-muted-foreground group-hover:text-ink">{c.letter}</span>
              {c.label}
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
</section>

<style>
  .blueprint {
    -webkit-mask-image: linear-gradient(to bottom, #000 88%, transparent);
    mask-image: linear-gradient(to bottom, #000 88%, transparent);
  }

  /*
   * The drafting sequence. Every step is a CSS animation with a fill of `both`, so before
   * its delay each element waits in its starting state, and without motion nothing moves.
   * --d is the delay, --t the duration, --i when the ink starts.
   */
  @media (prefers-reduced-motion: no-preference) {
    .bp-play {
      --ease: cubic-bezier(0.65, 0, 0.35, 1);
      --out: cubic-bezier(0.16, 1, 0.3, 1);
    }
    .bp-play :is(.bp-sweep, .bp-drop, .bp-grow) {
      transform-box: fill-box;
    }
    .bp-play .bp-sweep {
      transform-origin: center;
      animation: bp-scale-x 0.91s var(--out) var(--d) both;
    }
    .bp-play .bp-drop {
      transform-origin: top;
      animation: bp-scale-y 1.04s var(--ease) var(--d) both;
    }
    .bp-play .bp-grow {
      transform-origin: center;
      animation:
        bp-scale-xy 0.59s var(--out) var(--d) both,
        bp-fade 0.39s ease var(--d) both;
    }
    .bp-play .bp-draw {
      stroke-dasharray: 1 2;
      animation: bp-draw var(--t, 1s) var(--ease) var(--d) both;
    }
    .bp-play .bp-rise {
      animation: bp-rise 0.59s var(--out) var(--d) both;
    }
    /* Pencil, then ink: a hairline traces the mark, then swells to the full stroke. */
    .bp-play .mk-line {
      stroke-dasharray: 1 2;
      animation:
        bp-draw var(--t) var(--ease) var(--d) both,
        mk-ink 0.78s var(--out) var(--i) both;
    }
    .bp-play .nib-flow {
      transform-box: fill-box;
      transform-origin: top;
      animation: bp-scale-y 0.65s cubic-bezier(0.5, 0, 0.2, 1) var(--d) both;
    }
    .replay {
      animation: bp-fade 0.6s ease 3s both;
    }
  }

  @keyframes bp-scale-x {
    from { scale: 0 1; }
  }
  @keyframes bp-scale-y {
    from { scale: 1 0; }
  }
  @keyframes bp-scale-xy {
    from { scale: 0.2; }
  }
  @keyframes bp-fade {
    from { opacity: 0; }
  }
  @keyframes bp-draw {
    from { stroke-dashoffset: 1.02; }
    to { stroke-dashoffset: 0; }
  }
  @keyframes bp-rise {
    from { opacity: 0; translate: 0 6px; }
  }
  @keyframes mk-ink {
    from { stroke-width: 2.2px; }
  }
</style>

<script>
  // Numbers count up as their labels appear; "Draw again" restarts the whole sequence.
  const stage = document.querySelector<HTMLElement>('[data-blueprint]');
  const replay = document.querySelector<HTMLButtonElement>('[data-replay]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let timers: number[] = [];

  const countUp = () => {
    timers.forEach(clearTimeout);
    timers = [];
    stage?.querySelectorAll<SVGTSpanElement>('[data-count]').forEach((el) => {
      const target = Number(el.dataset.count);
      const dec = Number(el.dataset.dec ?? 0);
      const delay = parseFloat(getComputedStyle(el.parentElement!).getPropertyValue('--d')) * 1000 || 0;
      el.textContent = (0).toFixed(dec);
      timers.push(
        window.setTimeout(() => {
          const start = performance.now();
          const tick = (now: number) => {
            const t = Math.min(1, (now - start) / 900);
            const eased = 1 - Math.pow(1 - t, 3);
            el.textContent = (target * eased).toFixed(dec);
            if (t < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        }, delay),
      );
    });
  };

  if (stage && !reduce) {
    countUp();
    replay?.addEventListener('click', () => {
      stage.classList.remove('bp-play');
      void stage.getBoundingClientRect();
      stage.classList.add('bp-play');
      countUp();
    });
  } else if (replay) {
    replay.hidden = true;
  }
</script>

---
/**
 * The Rachna mark as an SVG group, in its own 301 × 528 coordinates, for use inside a
 * larger drawing. `parts` picks which pieces to draw.
 */
import { mark } from '../../lib/mark';

type Part = 'leaf' | 'vein' | 'nib';

interface Props {
  parts?: Part[];
  color?: string;
  transform?: string;
  class?: string;
}

const { parts = ['leaf', 'vein', 'nib'], color = '#111111', transform, class: className } = Astro.props;
const has = (p: Part) => parts.includes(p);
const line = { stroke: color, 'stroke-width': mark.stroke, 'stroke-linecap': 'round', 'stroke-linejoin': 'round', fill: 'none' } as const;
---

<g class={className} transform={transform}>
  {
    has('leaf') && (
      <>
        <path d={mark.leafRight} {...line} />
        <path d={mark.leafLeft} {...line} />
      </>
    )
  }
  {has('vein') && <path d={mark.vein} {...line} />}
  {
    has('nib') && (
      <g fill={color} stroke={color} stroke-width={mark.nibStroke}>
        <path d={mark.nibPath} />
      </g>
    )
  }
</g>

---
import * as simpleIcons from 'simple-icons';
import Logo from './Logo.astro';
import { site, legalLinks, socialLinks, hasAddress, fullAddress } from '../config/site';
import { products } from '../data/products';

const year = new Date().getFullYear();

const brandIcons = simpleIcons as unknown as Record<string, { path: string } | undefined>;
const LINKEDIN_PATH =
  'M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z';
const socialPath: Record<string, string | undefined> = {
  LinkedIn: LINKEDIN_PATH,
  X: brandIcons.siX?.path,
  GitHub: brandIcons.siGithub?.path,
  Instagram: brandIcons.siInstagram?.path,
};

const columns = [
  {
    title: 'Products',
    links: products.map((p) => ({ label: p.name, href: '/#products' })),
  },
  {
    title: 'Approach',
    links: [
      { label: 'Native by default', href: '/#approach' },
      { label: 'Made for India', href: '/#approach' },
      { label: 'Private by design', href: '/#approach' },
    ],
  },
  {
    title: 'Company',
    links: [
      { label: 'Contact', href: '/#contact' },
      { label: 'Careers', href: '/#contact' },
      { label: 'FAQ', href: '/#faq' },
    ],
  },
  { title: 'Legal', links: legalLinks },
];
---

<footer class="mt-3 border-t border-line bg-white">
  <div class="container-x py-14">
    <div class="grid gap-10 lg:grid-cols-[1fr_2fr]">
      <div>
        <Logo />
        <p class="mt-5 max-w-[16rem] text-[13px] leading-relaxed text-muted-foreground">Building thoughtful technology for everyday India.</p>
        <a href={`mailto:${site.email}`} class="mt-4 inline-block text-[13px] text-ink hover:text-blue">{site.email}</a>
        {
          socialLinks.length > 0 && (
            <div class="mt-5 flex gap-2">
              {socialLinks.map((s) => (
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${site.name} on ${s.label}`}
                  class="flex size-8 items-center justify-center rounded-full border border-line text-graphite hover:border-ink/25"
                >
                  <svg viewBox="0 0 24 24" class="size-3.5" fill="currentColor" aria-hidden="true">
                    <path d={socialPath[s.label]} />
                  </svg>
                </a>
              ))}
            </div>
          )
        }
      </div>
      <div class="grid grid-cols-2 gap-8 sm:grid-cols-4">
        {
          columns.map((col) => (
            <div>
              <h2 class="text-[13px] font-medium">{col.title}</h2>
              <ul class="mt-4 space-y-2.5">
                {col.links.map((link) => (
                  <li>
                    <a href={link.href} class="text-[13px] text-muted-foreground hover:text-blue">
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-3 border-t border-line pt-6 text-[12px] text-muted-foreground md:flex-row md:items-center md:justify-between">
      <p>© {year} {site.name}. {site.legalName} is a limited liability partnership registered in India.{site.llpin && ` LLPIN: ${site.llpin}.`}{site.gstin && ` GSTIN: ${site.gstin}.`}</p>
      <ul class="flex gap-5">
        {legalLinks.slice(0, 2).map((l) => <li><a href={l.href} class="hover:text-blue">{l.label}</a></li>)}
      </ul>
    </div>
    {hasAddress && <p class="mt-2 text-[12px] text-muted-foreground">Registered office: {fullAddress}</p>}
  </div>
</footer>

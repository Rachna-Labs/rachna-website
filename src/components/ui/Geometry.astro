---
/**
 * Wireframe geometry for section visuals, drawn in SVG: thin ink lines, dashed construction
 * lines, and one solid blue element to point the eye.
 */
type Shape = 'sphere' | 'cubes' | 'warp' | 'molecule' | 'network' | 'scripts' | 'shield' | 'rupee';

interface Props {
  shape: Shape;
  class?: string;
}

const { shape, class: className } = Astro.props;

const ink = '#333333';
const faint = '#C4C4C4';
const blue = '#111111';

// Isometric cube with its top-left-front corner at (x, y) and edge length s.
const iso = (x: number, y: number, s: number) => {
  const dx = s * 0.866;
  const dy = s * 0.5;
  const top = `M${x} ${y} L${x + dx} ${y - dy} L${x + 2 * dx} ${y} L${x + dx} ${y + dy} Z`;
  const left = `M${x} ${y} L${x + dx} ${y + dy} L${x + dx} ${y + dy + s} L${x} ${y + s} Z`;
  const right = `M${x + dx} ${y + dy} L${x + 2 * dx} ${y} L${x + 2 * dx} ${y + s} L${x + dx} ${y + dy + s} Z`;
  const hidden = `M${x} ${y + s} L${x + dx} ${y - dy + s} L${x + 2 * dx} ${y + s} M${x + dx} ${y - dy} L${x + dx} ${y - dy + s}`;
  return { top, left, right, hidden };
};

const c1 = iso(40, 120, 60);
const c2 = iso(178, 66, 60);
const c3 = iso(170, 188, 60);

const atoms = [
  { x: 150, y: 70, r: 14, solid: true },
  { x: 80, y: 120, r: 10 },
  { x: 222, y: 118, r: 10 },
  { x: 110, y: 210, r: 12 },
  { x: 200, y: 212, r: 9 },
  { x: 150, y: 150, r: 18 },
];
const bonds = [
  [0, 5],
  [1, 5],
  [2, 5],
  [3, 5],
  [4, 5],
  [0, 1],
  [3, 4],
];

const net = Array.from({ length: 11 }, (_, i) => {
  const a = (i / 11) * Math.PI * 2;
  const r = i % 2 ? 98 : 64;
  return { x: 150 + Math.cos(a) * r, y: 140 + Math.sin(a) * r * 0.8 };
});

const scripts = ['अ', 'அ', 'অ', 'అ', 'અ', 'ಅ', 'ਅ', 'അ', 'A'];
---

<svg viewBox="0 0 300 280" class={className} fill="none" aria-hidden="true">
  {
    shape === 'sphere' && (
      <g stroke={ink} stroke-width="1.2">
        <circle cx="150" cy="140" r="96" />
        <ellipse cx="150" cy="140" rx="96" ry="34" stroke-dasharray="4 5" stroke={faint} />
        <ellipse cx="150" cy="140" rx="34" ry="96" stroke-dasharray="4 5" stroke={faint} />
        <ellipse cx="150" cy="140" rx="96" ry="34" transform="rotate(48 150 140)" />
        <ellipse cx="150" cy="140" rx="96" ry="34" transform="rotate(-48 150 140)" stroke-dasharray="4 5" />
        <line x1="54" y1="140" x2="246" y2="140" stroke={faint} stroke-dasharray="2 4" />
        <line x1="150" y1="44" x2="150" y2="236" stroke={faint} stroke-dasharray="2 4" />
        <circle cx="214" cy="96" r="5" fill={blue} stroke="none" />
      </g>
    )
  }
  {
    shape === 'cubes' && (
      <g stroke={ink} stroke-width="1.2" stroke-linejoin="round">
        <path d="M144 150 L178 118 M144 150 L170 204" stroke={faint} stroke-dasharray="4 4" />
        {[c1, c3].map((c) => (
          <>
            <path d={c.hidden} stroke={faint} stroke-dasharray="3 4" />
            <path d={c.top} fill="#fff" />
            <path d={c.left} fill="#fff" />
            <path d={c.right} fill="#fff" />
          </>
        ))}
        <path d={c2.top} fill="#4A4A4A" stroke="#111111" />
        <path d={c2.left} fill="#111111" stroke="#111111" />
        <path d={c2.right} fill="#2A2A2A" stroke="#2A2A2A" />
      </g>
    )
  }
  {
    shape === 'warp' && (
      <g stroke={ink} stroke-width="1.2" stroke-linejoin="round">
        <path d="M70 70 Q150 104 230 70 Q204 140 230 210 Q150 176 70 210 Q96 140 70 70 Z" />
        <path d="M70 70 L110 40 Q170 66 250 40 L230 70" />
        <path d="M250 40 Q226 110 250 180 L230 210" />
        <path d="M110 40 Q134 110 110 180 Q170 154 250 180" stroke={faint} stroke-dasharray="4 5" />
        <path d="M70 210 L110 180" stroke={faint} stroke-dasharray="4 5" />
        <circle cx="150" cy="140" r="4" fill={blue} stroke="none" />
      </g>
    )
  }
  {
    shape === 'molecule' && (
      <g stroke={ink} stroke-width="1.2">
        {bonds.map(([a, b]) => <line x1={atoms[a].x} y1={atoms[a].y} x2={atoms[b].x} y2={atoms[b].y} stroke={faint} />)}
        {atoms.map((at) => <circle cx={at.x} cy={at.y} r={at.r} fill={at.solid ? blue : '#fff'} stroke={at.solid ? blue : ink} />)}
        <circle cx="150" cy="150" r="58" stroke={faint} stroke-dasharray="3 5" />
      </g>
    )
  }
  {
    shape === 'network' && (
      <g stroke-width="1.1">
        {net.map((p) => <line x1="150" y1="140" x2={p.x} y2={p.y} stroke={faint} />)}
        {net.map((p, i) => {
          const q = net[(i + 1) % net.length];
          return <line x1={p.x} y1={p.y} x2={q.x} y2={q.y} stroke={faint} stroke-dasharray="3 4" />;
        })}
        {net.map((p, i) => <circle cx={p.x} cy={p.y} r={i % 3 === 0 ? 7 : 5} fill="#fff" stroke={ink} />)}
        <circle cx="150" cy="140" r="16" fill={blue} />
      </g>
    )
  }
  {
    shape === 'scripts' && (
      <g>
        {scripts.map((ch, i) => {
          const x = 60 + (i % 3) * 90;
          const y = 50 + Math.floor(i / 3) * 90;
          const on = i === 4;
          return (
            <>
              <rect x={x - 34} y={y - 34} width="68" height="68" rx="14" fill={on ? blue : '#fff'} stroke={on ? blue : faint} />
              <text x={x} y={y + 12} text-anchor="middle" font-size="32" font-family="'Noto Sans Devanagari Variable', 'Noto Sans Tamil Variable', 'Noto Sans Bengali Variable', 'Noto Sans Telugu Variable', 'Noto Sans Gujarati Variable', sans-serif" fill={on ? '#fff' : ink}>
                {ch}
              </text>
            </>
          );
        })}
      </g>
    )
  }
  {
    shape === 'shield' && (
      <g stroke={ink} stroke-width="1.2">
        {[110, 80, 50].map((r) => <circle cx="150" cy="140" r={r} stroke={faint} stroke-dasharray="3 5" />)}
        <path d="M150 78 L196 96 V138 C196 168 176 188 150 200 C124 188 104 168 104 138 V96 Z" fill="#fff" />
        <path d="M130 140 L146 156 L174 124" stroke={blue} stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
        <circle cx="236" cy="96" r="5" fill={blue} stroke="none" />
      </g>
    )
  }
  {
    shape === 'rupee' && (
      <g stroke={ink} stroke-width="1.2">
        <path d="M40 220 H260" stroke={faint} />
        {[60, 92, 74, 120, 104, 150].map((h, i) => (
          <rect x={56 + i * 34} y={220 - h} width="20" height={h} rx="4" fill={i === 5 ? blue : '#fff'} stroke={i === 5 ? blue : ink} />
        ))}
        <path d="M60 150 C 100 120, 130 140, 170 96 S 230 60, 250 40" stroke={blue} stroke-dasharray="4 5" />
        <text x="250" y="30" font-size="22" text-anchor="middle" fill={ink} stroke="none">₹</text>
      </g>
    )
  }
</svg>

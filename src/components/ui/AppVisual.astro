---
/**
 * The scene for one app in the apps showcase: a few calm cards composed around the app's
 * main idea. Everything is sized in container units (cqmin), so a scene keeps its proportions
 * in any box. Colours come from the slide (--ink, --accent, --soft); no shadows, hairline borders.
 * Plate uses its real food cut-outs and Balance its app icon, both from their repos; the other
 * scenes are placeholders drawn in code until those apps are designed.
 */
import { Image } from 'astro:assets';
import { ArrowUpRight, BookOpen, Calendar, Check, Flame, Heart, MapPin, MessageCircle, Navigation, Play, Search, ShieldCheck, TrendingUp } from '@lucide/astro';
import * as simpleIcons from 'simple-icons';
import basket from '../../assets/apps/plate-basket.webp';
import dal from '../../assets/apps/plate-dal.webp';
import roti from '../../assets/apps/plate-roti.webp';
import sprouts from '../../assets/apps/plate-sprouts.webp';
import balanceIcon from '../../assets/apps/balance-icon.png';

interface Props {
  app: string;
}

const { app } = Astro.props;
const icons = simpleIcons as unknown as Record<string, { path: string }>;

const macros = [
  { label: 'Protein', value: '42 g', fill: 70 },
  { label: 'Fibre', value: '18 g', fill: 72 },
  { label: 'Iron', value: '9 mg', fill: 50 },
];
const spend = [
  { name: 'Groceries', amount: '₹6,240', share: 34, colour: 'var(--accent)' },
  { name: 'Bills', amount: '₹3,900', share: 21, colour: 'color-mix(in srgb, var(--accent) 60%, white)' },
  { name: 'Travel', amount: '₹2,180', share: 12, colour: 'color-mix(in srgb, var(--accent) 35%, white)' },
  { name: 'Other', amount: '₹6,100', share: 33, colour: 'color-mix(in srgb, var(--ink) 18%, white)' },
];
let start = 0;
const donut = spend
  .map((s) => {
    const seg = `${s.colour} ${start}% ${start + s.share}%`;
    start += s.share;
    return seg;
  })
  .join(', ');
const payments = [
  { who: 'Chai Point', how: 'UPI · 9:12 AM', amount: '−₹120' },
  { who: 'Reliance Fresh', how: 'UPI · Yesterday', amount: '−₹1,460' },
];
const week = [32, 54, 40, 76, 58, 90, 64];
const days = ['M', 'T', 'W', 'T', 'F', 'S', 'S'];
---

<div class="scene absolute inset-0" aria-hidden="true">
  {
    app === 'plate' && (
      <>
        <span class="disc absolute inset-[8%] rounded-full" />
        <Image src={basket} alt="" width={700} class="float absolute top-[18%] left-[16%] w-[66%]" />
        <Image src={dal} alt="" width={320} class="float absolute top-[4%] right-[10%] w-[20%]" style="--d: -2s" />
        <Image src={roti} alt="" width={320} class="float absolute bottom-[6%] left-[4%] w-[22%]" style="--d: -4s" />
        <Image src={sprouts} alt="" width={320} class="float absolute right-[2%] bottom-[22%] w-[18%]" style="--d: -1s" />

        <div class="glass absolute top-[6%] left-[2%] w-[46%] p-[3cqmin]">
          <p class="row gap-[2cqmin] rounded-full bg-white px-[3cqmin] py-[1.8cqmin] text-[3.2cqmin]">
            <Search class="size-[3.4cqmin] opacity-50" />
            <span lang="hi">दाल</span>
            <span class="caret" />
          </p>
          <p class="row mt-[2.4cqmin] justify-between text-[3cqmin]">
            <span>
              <b>Dal tadka</b>
              <span lang="hi" class="block text-[2.6cqmin] opacity-60">
                दाल तड़का
              </span>
            </span>
            <span class="pill">1 katori</span>
          </p>
        </div>

        <div class="glass absolute right-[4%] bottom-[4%] w-[40%] p-[3cqmin]">
          <p class="text-[2.4cqmin] tracking-[0.12em] uppercase opacity-60">Today</p>
          <ul class="mt-[2cqmin] space-y-[2cqmin]">
            {macros.map((m) => (
              <li class="text-[2.8cqmin]">
                <span class="row justify-between">
                  <span>{m.label}</span>
                  <b>{m.value}</b>
                </span>
                <span class="bar mt-[1cqmin]">
                  <span style={`width: ${m.fill}%`} />
                </span>
              </li>
            ))}
          </ul>
        </div>
      </>
    )
  }

  {
    app === 'grokul' && (
      <>
        <div class="tile absolute top-[6%] left-[2%] h-[88%] w-[56%] overflow-hidden bg-[var(--accent)] p-[5cqmin] text-white">
          <p class="row gap-[1.6cqmin] text-[3.4cqmin] text-white/70">
            <BookOpen class="size-[3.6cqmin]" /> Science · Chapter 6
          </p>
          <p lang="hi" class="mt-[3cqmin] text-[10cqmin] leading-[1.05] font-light">
            प्रकाश संश्लेषण
          </p>
          <p class="mt-[1cqmin] text-[3.6cqmin] text-white/70">Photosynthesis</p>
          <div class="absolute right-[5cqmin] bottom-[5cqmin] left-[5cqmin] row justify-between">
            <span class="row gap-[2cqmin] text-[3.2cqmin]">
              <span class="play">
                <Play class="size-[3.4cqmin]" fill="currentColor" />
              </span>
              Lesson 3 of 5 · 6 min
            </span>
            <span class="ring" style="--p: 60" />
          </div>
          <div class="letters absolute right-[5cqmin] bottom-[17cqmin] grid grid-cols-2 gap-[2cqmin] text-[6cqmin]">
            {['अ', 'आ', 'इ', 'ई'].map((l) => (
              <span lang="hi">{l}</span>
            ))}
          </div>
        </div>
        <div class="absolute top-[6%] right-[2%] flex h-[88%] w-[38%] flex-col gap-[2.4cqmin]">
          <p lang="hi" class="card p-[3.4cqmin] text-[3.4cqmin] leading-snug">
            पौधे भोजन बनाने के लिए क्या लेते हैं?
          </p>
          <p lang="hi" class="card option is-right">
            धूप, पानी और CO₂ <Check class="size-[3.6cqmin]" />
          </p>
          <p lang="hi" class="card option">सिर्फ़ मिट्टी</p>
          <p class="card row mt-auto justify-between p-[3.4cqmin] text-[3.2cqmin]">
            <span class="row gap-[1.6cqmin]">
              <Flame class="size-[3.8cqmin] text-[var(--accent)]" /> 5-day streak
            </span>
            <span class="row gap-[1cqmin]">
              {days.slice(0, 5).map((_, i) => (
                <span class:list={['size-[2cqmin] rounded-full', i < 5 ? 'bg-[var(--accent)]' : 'bg-[var(--soft)]']} />
              ))}
            </span>
          </p>
        </div>
      </>
    )
  }

  {
    app === 'beside' && (
      <>
        <div class="map absolute inset-[4%] overflow-hidden rounded-full">
          <svg viewBox="0 0 100 100" class="absolute inset-0 size-full">
            <path d="M18 84 C 26 68, 44 70, 50 54 S 70 32, 78 20" fill="none" stroke="var(--accent)" stroke-opacity="0.25" stroke-width="3.2" stroke-linecap="round" />
            <path class="route" d="M18 84 C 26 68, 44 70, 50 54 S 70 32, 78 20" fill="none" stroke="var(--accent)" stroke-width="1.6" stroke-linecap="round" />
          </svg>
          <span class="you absolute top-[52%] left-[49%] size-[4cqmin] -translate-1/2 rounded-full border-[0.8cqmin] border-white bg-[var(--accent)]" />
          <span class="absolute top-[18%] left-[78%] flex size-[7cqmin] -translate-1/2 items-center justify-center rounded-full border border-[var(--line-c)] bg-white text-[var(--accent)]">
            <MapPin class="size-[3.6cqmin]" />
          </span>
        </div>
        <div class="card absolute top-[8%] left-[0%] w-[52%] p-[3.4cqmin]">
          <p class="row gap-[1.6cqmin] text-[3cqmin] opacity-60">
            <Navigation class="size-[3.2cqmin] text-[var(--accent)]" /> Sharing your trip
          </p>
          <p class="mt-[1.4cqmin] text-[5cqmin] leading-tight font-light">Home in 12 min</p>
          <div class="row mt-[2.4cqmin] -space-x-[1.6cqmin]">
            {['M', 'P', 'R'].map((x, i) => (
              <span class="avatar" style={`--i: ${i}`}>
                {x}
              </span>
            ))}
            <span class="ml-[3cqmin] text-[2.8cqmin] opacity-60">Maa, Papa, Riya can see you</span>
          </div>
        </div>
        <div class="card absolute right-[0%] bottom-[8%] row w-[50%] gap-[2.6cqmin] p-[2.6cqmin]">
          <span class="sos">
            <ShieldCheck class="size-[4.4cqmin]" />
          </span>
          <span class="text-[3cqmin] leading-tight">
            <b class="block">Hold for SOS</b>
            <span class="opacity-60">From your phone or watch</span>
          </span>
        </div>
      </>
    )
  }

  {
    app === 'balance' && (
      <>
        <div class="absolute inset-[3%] flex flex-col justify-between gap-[3cqmin]">
        <div class="card p-[4.4cqmin]">
          <div class="row justify-between">
            <span class="text-[3cqmin] opacity-60">Spent in October</span>
            <Image src={balanceIcon} alt="" width={64} class="size-[7cqmin] rounded-[1.8cqmin]" />
          </div>
          <div class="row mt-[2cqmin] items-center gap-[5cqmin]">
            <span class="donut" style={`background: conic-gradient(${donut})`}>
              <span class="donut-hole">
                <span class="text-[2.4cqmin] opacity-60">of ₹25,000</span>
                <b class="text-[4cqmin] font-medium">74%</b>
              </span>
            </span>
            <div>
              <p class="text-[9cqmin] leading-none font-light tracking-tight tabular-nums">₹18,420</p>
              <ul class="mt-[2.6cqmin] grid grid-cols-2 gap-x-[3cqmin] gap-y-[1.2cqmin] text-[2.6cqmin]">
                {spend.map((s) => (
                  <li class="row gap-[1.2cqmin]">
                    <span class="size-[1.8cqmin] rounded-full" style={`background: ${s.colour}`} />
                    {s.name}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
        <div class="card p-[3.4cqmin]">
          {payments.map((p, i) => (
            <p class:list={['row justify-between text-[3cqmin]', i > 0 && 'mt-[2.4cqmin] border-t border-[var(--line-c)] pt-[2.4cqmin]']}>
              <span class="row gap-[2cqmin]">
                <span class="avatar">{p.who[0]}</span>
                <span class="leading-tight">
                  <b class="block font-medium">{p.who}</b>
                  <span class="text-[2.6cqmin] opacity-60">{p.how}</span>
                </span>
              </span>
              <span class="tabular-nums">{p.amount}</span>
            </p>
          ))}
        </div>
        <div class="card row items-end justify-between gap-[3cqmin] p-[3.4cqmin]">
          <div>
            <p class="text-[3cqmin] opacity-60">Gullak</p>
            <p class="text-[6cqmin] leading-none font-light tabular-nums">₹2,000</p>
            <p class="text-[2.6cqmin] opacity-60">saved this month</p>
          </div>
          <div class="flex h-[12cqmin] flex-1 items-end gap-[1.4cqmin]">
            {week.map((v, i) => (
              <span class:list={['flex-1 rounded-t-[1cqmin]', i === 5 ? 'bg-[var(--accent)]' : 'bg-[var(--soft)]']} style={`height: ${v}%`} />
            ))}
          </div>
        </div>
        </div>
      </>
    )
  }

  {
    app === 'paparazi' && (
      <>
        <div class="poster absolute top-[4%] left-[8%] h-[68%] w-[60%] -rotate-[5deg] overflow-hidden">
          <span class="poster-sun" />
          <div class="relative flex h-full flex-col justify-between p-[4.4cqmin] text-white">
            <p class="row justify-between text-[2.8cqmin] tracking-[0.14em] uppercase">
              <span>Sharma Sweets</span>
              <span>Since 1984</span>
            </p>
            <div>
              <p class="text-[13cqmin] leading-[0.85] font-extrabold tracking-[-0.04em]">
                Diwali
                <br />
                Box
              </p>
              <p class="mt-[2cqmin] inline-flex rounded-full bg-white px-[3cqmin] py-[1.2cqmin] text-[3cqmin] font-bold text-[var(--accent)]">20% off till Sunday</p>
            </div>
          </div>
        </div>

        <div class="card absolute top-[10%] right-[2%] w-[40%] p-[2.8cqmin]">
          <p class="row gap-[1.4cqmin] text-[2.6cqmin] opacity-60">
            <Calendar class="size-[3cqmin]" /> Scheduled
          </p>
          <ul class="mt-[2cqmin] space-y-[1.8cqmin] text-[2.8cqmin]">
            {[
              { k: 'siInstagram', t: 'Instagram', at: '7:30 PM' },
              { k: 'siWhatsapp', t: 'WhatsApp', at: '7:30 PM' },
              { k: 'siGoogle', t: 'Google', at: '8:00 PM' },
            ].map((c) => (
              <li class="row justify-between">
                <span class="row gap-[1.6cqmin]">
                  <svg viewBox="0 0 24 24" class="size-[3.4cqmin]" fill="currentColor">
                    <path d={icons[c.k]?.path} />
                  </svg>
                  {c.t}
                </span>
                <span class="opacity-60 tabular-nums">{c.at}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="card absolute right-[2%] bottom-[4%] w-[52%] p-[3cqmin]">
          <div class="row justify-between">
            <p class="text-[2.8cqmin] opacity-60">Reach this week</p>
            <p class="row gap-[1cqmin] text-[2.8cqmin] font-semibold text-[var(--accent)]">
              <TrendingUp class="size-[3.2cqmin]" /> 38%
            </p>
          </div>
          <p class="mt-[0.6cqmin] text-[7cqmin] leading-none font-extrabold tracking-[-0.03em] tabular-nums">4,820</p>
          <div class="mt-[2cqmin] flex h-[9cqmin] items-end gap-[1.2cqmin]">
            {week.map((v, i) => (
              <span class:list={['flex-1 rounded-[1cqmin]', i === 6 ? 'bg-[var(--accent)]' : 'bg-[var(--soft)]']} style={`height: ${v}%`} />
            ))}
          </div>
        </div>

        <p class="card row absolute bottom-[10%] left-[2%] gap-[2cqmin] px-[3cqmin] py-[2cqmin] text-[2.8cqmin]">
          <Heart class="size-[3.4cqmin] text-[var(--accent)]" fill="currentColor" /> 312
          <MessageCircle class="ml-[1cqmin] size-[3.4cqmin] opacity-60" /> 48
          <ArrowUpRight class="ml-[1cqmin] size-[3.4cqmin] opacity-60" /> 27
        </p>
      </>
    )
  }
</div>

<style>
  .scene {
    container-type: size;
    text-align: left;
    --line-c: color-mix(in srgb, var(--ink) 10%, transparent);
    color: var(--ink);
  }
  .scene :global(.row) {
    display: flex;
    align-items: center;
  }
  .card {
    border-radius: min(var(--app-radius), 6cqmin);
    border: 1px solid var(--line-c);
    background: #fff;
  }
  .tile {
    border-radius: min(var(--app-radius), 6cqmin);
  }
  /* Plate's glass: white at 62%, blurred, with a light top edge and no shadow */
  .glass {
    border-radius: 5cqmin;
    border: 1px solid rgb(255 255 255 / 0.9);
    background: rgb(255 255 255 / 0.62);
    -webkit-backdrop-filter: blur(22px);
    backdrop-filter: blur(22px);
  }
  .disc {
    background: radial-gradient(closest-side, rgb(255 255 255 / 0.85), color-mix(in srgb, var(--accent) 14%, white) 100%);
  }
  .pill {
    border-radius: 999px;
    background: var(--soft);
    color: var(--accent);
    padding: 0.8cqmin 2.4cqmin;
    font-size: 2.6cqmin;
    font-weight: 600;
  }
  .bar {
    display: block;
    height: 1.2cqmin;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 14%, white);
  }
  .bar > span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--accent);
  }
  .caret {
    width: 1px;
    height: 3.4cqmin;
    background: var(--ink);
  }
  .option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 3.2cqmin 3.6cqmin;
    font-size: 3.4cqmin;
  }
  .option.is-right {
    border-color: var(--ink);
    background: var(--ink);
    color: #fff;
  }
  .play {
    display: flex;
    width: 8cqmin;
    height: 8cqmin;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: #fff;
    color: var(--accent);
  }
  .ring {
    width: 9cqmin;
    height: 9cqmin;
    border-radius: 999px;
    background:
      radial-gradient(closest-side, var(--accent) 72%, transparent 73% 100%),
      conic-gradient(#fff calc(var(--p) * 1%), rgb(255 255 255 / 0.25) 0);
  }
  .letters span {
    display: flex;
    width: 11cqmin;
    height: 11cqmin;
    align-items: center;
    justify-content: center;
    border-radius: 3cqmin;
    border: 1px solid rgb(255 255 255 / 0.25);
    color: rgb(255 255 255 / 0.85);
  }
  .map {
    background:
      linear-gradient(90deg, rgb(255 255 255 / 0.9) 0.5cqmin, transparent 0.5cqmin) 0 0 / 9cqmin 100%,
      linear-gradient(rgb(255 255 255 / 0.9) 0.5cqmin, transparent 0.5cqmin) 0 0 / 100% 10cqmin,
      linear-gradient(32deg, transparent 47%, rgb(255 255 255 / 0.95) 47% 50%, transparent 50%),
      color-mix(in srgb, var(--accent) 10%, white);
  }
  .avatar {
    display: inline-flex;
    width: 7cqmin;
    height: 7cqmin;
    flex: none;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 0.5cqmin solid #fff;
    background: color-mix(in srgb, var(--accent) calc(30% + var(--i, 0) * 20%), white);
    color: var(--ink);
    font-size: 2.8cqmin;
    font-weight: 600;
  }
  .sos {
    display: flex;
    width: 10cqmin;
    height: 10cqmin;
    flex: none;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: var(--ink);
    color: #fff;
  }
  .donut {
    position: relative;
    display: block;
    width: 22cqmin;
    height: 22cqmin;
    flex: none;
    border-radius: 999px;
  }
  .donut-hole {
    position: absolute;
    inset: 18%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: #fff;
    line-height: 1.15;
  }
  .poster {
    border-radius: min(var(--app-radius), 6cqmin);
    background: linear-gradient(150deg, var(--accent) 0%, color-mix(in srgb, var(--accent) 70%, var(--ink)) 60%, var(--ink) 100%);
  }
  .poster-sun {
    position: absolute;
    right: -18%;
    top: 18%;
    width: 70%;
    aspect-ratio: 1;
    border-radius: 999px;
    background: radial-gradient(closest-side, #ffd6a3 0%, rgb(255 180 120 / 0.6) 45%, rgb(255 180 120 / 0) 100%);
  }
  @media (prefers-reduced-motion: no-preference) {
    .float {
      animation: float 7s ease-in-out infinite;
      animation-delay: var(--d, 0s);
    }
    .caret {
      animation: blink 1.1s steps(1) infinite;
    }
    .you::after {
      content: '';
      position: absolute;
      inset: -0.8cqmin;
      border-radius: 999px;
      background: var(--accent);
      animation: ping 2s ease-out infinite;
    }
    .route {
      stroke-dasharray: 140;
      animation: draw 4s ease-in-out infinite alternate;
    }
  }
  @keyframes float {
    50% {
      translate: 0 -1.6cqmin;
    }
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @keyframes ping {
    to {
      scale: 2.6;
      opacity: 0;
    }
  }
  @keyframes draw {
    from {
      stroke-dashoffset: 140;
    }
  }
</style>

---
/** An app icon: Sakhi's real icon, or a squircle in the app's tint with a glyph. */
import { Image } from 'astro:assets';
import { BookOpen, Camera, MapPin, UtensilsCrossed, Wallet } from '@lucide/astro';
import sakhiIcon from '../../assets/sakhi/icon.png';
import type { Product } from '../../data/products';

interface Props {
  product: Product;
  class?: string;
}

const { product, class: className } = Astro.props;
const glyphs = { plate: UtensilsCrossed, grokul: BookOpen, beside: MapPin, paid: Wallet, paparazi: Camera } as const;
const Glyph = glyphs[product.key as keyof typeof glyphs];
---

{
  product.key === 'sakhi' ? (
    <Image src={sakhiIcon} alt="" width={128} height={128} class:list={['app-icon object-cover', className]} />
  ) : (
    <span
      class:list={['app-icon flex items-center justify-center text-white', className]}
      style={`background: linear-gradient(145deg, ${product.tint[0]}, ${product.tint[1]})`}
      aria-hidden="true"
    >
      {Glyph && <Glyph class="size-[46%]" stroke-width={2.2} />}
    </span>
  )
}

<style>
  .app-icon {
    border-radius: 23%;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.35),
      0 8px 20px -10px rgb(0 0 0 / 0.45);
  }
</style>

---
/**
 * The Rachna Labs logo: the mark, a leaf whose stem ends in a pen nib, with the wordmark.
 * The mark takes the text colour, so it is black on light and white on dark.
 */
import mark from '../assets/brand/mark.svg?raw';

interface Props {
  class?: string;
  href?: string;
}

const { class: className, href = '/' } = Astro.props;
---

<a href={href} class:list={['inline-flex items-center gap-2 text-ink', className]} aria-label="Rachna Labs home">
  <span class="logo-mark block h-[26px] w-[15px] shrink-0" aria-hidden="true" set:html={mark} />
  <span class="text-[20px] leading-none tracking-[-0.02em]"><span class="font-medium">Rachna</span> <span class="font-light text-muted-foreground">Labs</span></span>
</a>

<style>
  .logo-mark :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

---
import { Image } from 'astro:assets';
import { BookOpen, Flame, Navigation, Search, ShieldAlert } from '@lucide/astro';
import * as simpleIcons from 'simple-icons';
import AppIcon from '../ui/AppIcon.astro';
import Phone from '../ui/Phone.astro';
import ProductStage from '../ui/ProductStage.astro';
import { products, type Product } from '../../data/products';

import sakhiHome from '../../assets/sakhi/home.webp';
import sakhiLog from '../../assets/sakhi/log.webp';
import sakhiCare from '../../assets/sakhi/care.webp';
import sakhiWatch from '../../assets/sakhi/watch.webp';
import thali from '../../assets/plate/thali.webp';
import dal from '../../assets/plate/food-dal.webp';
import paneer from '../../assets/plate/food-paneer.webp';
import curd from '../../assets/plate/food-curd.webp';
import tomatoes from '../../assets/plate/edge-tomatoes.webp';
import chilli from '../../assets/plate/deco-chilli.webp';
import lemon from '../../assets/plate/deco-lemon.webp';
import dhokla from '../../assets/plate/dhokla.webp';

const p = (key: string) => products.find((x) => x.key === key) as Product;
const icons = simpleIcons as unknown as Record<string, { path: string }>;

const spending = [
  { name: 'Groceries', amount: '₹6,240', share: 72, color: '#0B6B4F' },
  { name: 'Bills', amount: '₹3,900', share: 46, color: '#D98E0B' },
  { name: 'Travel', amount: '₹2,180', share: 28, color: '#3546A5' },
  { name: 'Chai & snacks', amount: '₹860', share: 12, color: '#E0532F' },
];
---

<section id="apps" data-theme="paper" class="scroll-mt-12 pt-28 pb-10 sm:pt-40">
  <div class="container-x text-center">
    <p class="text-muted text-[15px] font-medium sm:text-[17px]">The apps</p>
    <h2 class="mt-3 font-display text-[2.8rem] leading-[1.02] font-semibold tracking-[-0.045em] sm:text-[4.8rem]" data-reveal>
      Meet the <span class="text-gradient">family.</span>
    </h2>
    <p class="text-muted mx-auto mt-5 max-w-xl text-lg leading-relaxed sm:text-[21px]" data-reveal>
      Six apps for the moments that matter in an Indian day. Scroll, and each one shows you its world.
    </p>
    <ul class="mx-auto mt-12 flex max-w-3xl flex-wrap justify-center gap-x-6 gap-y-5" data-reveal>
      {
        products.map((x) => (
          <li>
            <a href={`/#app-${x.key}`} class="group flex flex-col items-center gap-2">
              <AppIcon product={x} class="size-16 transition-transform duration-300 group-hover:-translate-y-1 sm:size-[72px]" />
              <span class="text-[13px] font-medium">{x.name}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<!-- Sakhi -->
<ProductStage product={p('sakhi')}>
  <div class="relative mx-auto h-[520px] max-w-[560px] sm:h-[620px]">
    <div class="absolute inset-x-[8%] top-[18%] bottom-[8%] -z-10 rounded-[48px] bg-gradient-to-br from-[#F6B9CF] via-[#F3A6C2] to-[#E86B98] opacity-60 blur-2xl"></div>
    <Image src={sakhiLog} alt="Logging flow and symptoms in Sakhi" width={500} class="absolute top-[12%] left-0 w-[38%] -rotate-[8deg] drop-shadow-2xl" />
    <Image src={sakhiCare} alt="Sharing care with a partner in Sakhi" width={500} class="absolute top-[12%] right-0 w-[38%] rotate-[8deg] drop-shadow-2xl" />
    <Image src={sakhiHome} alt="Sakhi's home screen showing day 2 of a period" width={600} class="absolute top-0 left-1/2 z-10 w-[46%] -translate-x-1/2 drop-shadow-2xl" />
    <Image src={sakhiWatch} alt="Sakhi on Apple Watch" width={320} class="absolute bottom-0 left-[4%] z-20 w-[26%] -rotate-6 drop-shadow-2xl" />
    <span class="glass absolute right-[2%] bottom-[6%] z-20 rounded-full px-4 py-2 text-[13px] font-semibold">On iPhone and Apple Watch</span>
  </div>
</ProductStage>

<!-- Plate -->
<ProductStage product={p('plate')} reverse>
  <div class="relative mx-auto h-[520px] max-w-[560px] sm:h-[600px]">
    <div class="glass absolute inset-x-[6%] top-[4%] bottom-[14%] overflow-hidden rounded-[44px]">
      <Image src={thali} alt="Dal, roti, sabzi and curd on a steel thali" width={900} class="size-full object-cover" />
    </div>
    <Image src={dal} alt="" width={220} class="plate-float absolute -top-2 -left-2 w-[26%] drop-shadow-2xl" style="--d: 0s" />
    <Image src={tomatoes} alt="" width={200} class="plate-float absolute top-[30%] -right-4 w-[22%] drop-shadow-2xl" style="--d: -2s" />
    <Image src={chilli} alt="" width={120} class="plate-float absolute top-[8%] right-[10%] w-[12%] rotate-12 drop-shadow-xl" style="--d: -3s" />
    <Image src={lemon} alt="" width={120} class="plate-float absolute bottom-[30%] -left-3 w-[13%] drop-shadow-xl" style="--d: -1s" />

    <div class="glass absolute right-0 bottom-0 left-[14%] rounded-[28px] p-4 sm:left-[22%] sm:p-5">
      <div class="flex items-center gap-2.5 rounded-full bg-white/80 px-4 py-2.5">
        <Search class="size-4 opacity-50" />
        <span lang="hi" class="text-[15px]">दाल</span>
        <span class="ml-auto h-4 w-px animate-pulse bg-current"></span>
      </div>
      <ul class="mt-2">
        {
          [
            { img: dal, en: 'Dal tadka', hi: 'दाल तड़का', portion: '1 katori' },
            { img: paneer, en: 'Paneer', hi: 'पनीर', portion: '100 g' },
            { img: curd, en: 'Dahi', hi: 'दही', portion: '1 katori' },
          ].map((f) => (
            <li class="flex items-center gap-3 py-2">
              <Image src={f.img} alt="" width={80} class="size-10 object-contain" />
              <span class="flex-1">
                <span class="block text-sm font-semibold">{f.en}</span>
                <span lang="hi" class="text-muted block text-xs">{f.hi}</span>
              </span>
              <span class="rounded-full px-2.5 py-1 text-xs font-semibold" style="background: #d8f1e4; color: #0d6646">{f.portion}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</ProductStage>

<!-- Beside -->
<ProductStage product={p('beside')}>
  <div class="relative mx-auto flex h-[560px] max-w-[560px] items-center justify-center sm:h-[640px]">
    <div class="absolute size-[80%] rounded-full bg-[#3FD1C2]/20 blur-3xl"></div>
    <Phone dark class="relative w-[62%] max-w-[300px]">
      <div class="beside-map absolute inset-0 top-11">
        <svg viewBox="0 0 300 560" class="absolute inset-0 size-full" preserveAspectRatio="none" aria-hidden="true">
          <path d="M60 520 C 70 430, 150 420, 160 340 S 230 230, 220 120" fill="none" stroke="#3FD1C2" stroke-width="6" stroke-linecap="round" stroke-dasharray="2 12" />
          <path d="M60 520 C 70 430, 150 420, 160 340" fill="none" stroke="#3FD1C2" stroke-width="6" stroke-linecap="round" />
        </svg>
        <span class="absolute top-[57%] left-[52%] size-4 -translate-x-1/2 -translate-y-1/2 rounded-full bg-[#3FD1C2] ring-4 ring-[#3FD1C2]/30">
          <span class="absolute inset-0 animate-ping rounded-full bg-[#3FD1C2]"></span>
        </span>
        <span class="absolute top-[19%] left-[72%] flex size-7 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-white text-[11px] font-bold text-[#061A1B]">⌂</span>
      </div>
      <div class="glass absolute inset-x-3 top-14 rounded-2xl p-3">
        <p class="flex items-center gap-2 text-[13px] font-semibold"><Navigation class="size-3.5 text-[#3FD1C2]" /> Sharing live with Maa</p>
        <p class="mt-0.5 text-[11px] text-white/60">Home in 12 min · 2.4 km</p>
      </div>
      <div class="absolute inset-x-3 bottom-5 flex items-center gap-2 rounded-full bg-[#E5484D] p-1.5 pr-4 text-white">
        <span class="flex size-9 items-center justify-center rounded-full bg-white/20"><ShieldAlert class="size-4" /></span>
        <span class="text-[13px] font-semibold">Hold for SOS</span>
      </div>
    </Phone>
    <div class="glass absolute right-0 bottom-[14%] flex items-center gap-3 rounded-[22px] p-3 pr-5 sm:right-[2%]">
      <span class="flex size-10 items-center justify-center rounded-full bg-gradient-to-br from-[#F2B230] to-[#E0532F] text-sm font-bold text-white">M</span>
      <span>
        <span class="block text-[13px] font-semibold">Maa can see your trip</span>
        <span class="block text-[11px] text-white/60">Until you reach home</span>
      </span>
    </div>
    <div class="absolute top-[10%] left-0 w-[30%] max-w-[140px] rounded-[30%] bg-[#111] p-1.5 shadow-2xl sm:left-[2%]">
      <div class="flex aspect-[4/5] flex-col items-center justify-center rounded-[26%] bg-black">
        <span class="flex size-14 items-center justify-center rounded-full bg-[#E5484D] text-sm font-bold text-white">SOS</span>
        <span class="mt-2 text-[10px] text-white/60">Hold 3 sec</span>
      </div>
    </div>
  </div>
</ProductStage>

<!-- Paid -->
<ProductStage product={p('paid')} reverse>
  <div class="relative mx-auto flex h-[560px] max-w-[560px] items-center justify-center sm:h-[640px]">
    <div class="absolute size-[80%] rounded-full bg-[#F2B230]/30 blur-3xl"></div>
    <Phone class="relative w-[62%] max-w-[300px]">
      <div class="px-5 pt-3">
        <p class="text-[12px] font-medium text-[#76683F]">October</p>
        <p class="mt-1 font-display text-[34px] leading-none font-semibold tracking-tight">₹18,420</p>
        <p class="mt-1 text-[11px] text-[#76683F]">spent of your ₹25,000 plan</p>
        <div class="mt-3 h-2 rounded-full bg-[#F4ECD6]"><div class="h-2 w-[74%] rounded-full bg-[#0B6B4F]"></div></div>
        <ul class="mt-6 space-y-4">
          {
            spending.map((s) => (
              <li>
                <div class="flex items-center justify-between text-[12px]">
                  <span class="flex items-center gap-2 font-semibold"><span class="size-2.5 rounded-[4px]" style={`background: ${s.color}`} />{s.name}</span>
                  <span class="font-semibold tabular-nums">{s.amount}</span>
                </div>
                <div class="mt-1.5 h-1.5 rounded-full bg-[#F4ECD6]"><div class="h-1.5 rounded-full" style={`width: ${s.share}%; background: ${s.color}`} /></div>
              </li>
            ))
          }
        </ul>
        <div class="mt-6 rounded-2xl bg-[#FFF2D2] p-3">
          <p class="text-[11px] text-[#76683F]">This week</p>
          <div class="mt-2 flex h-14 items-end gap-1.5">
            {[40, 62, 35, 80, 52, 68, 30].map((h) => <span class="flex-1 rounded-t-md bg-[#0B6B4F]/80" style={`height: ${h}%`} />)}
          </div>
        </div>
      </div>
    </Phone>
    <div class="glass absolute top-[12%] right-0 rounded-[22px] p-3 pr-5 sm:right-[4%]">
      <p class="text-[11px] opacity-60">UPI · Chai Point</p>
      <p class="text-[15px] font-semibold">₹120 logged</p>
    </div>
    <div class="glass absolute bottom-[12%] left-0 rounded-[22px] p-3 pr-5 sm:left-[2%]">
      <p class="text-[11px] opacity-60">Gullak</p>
      <p class="text-[15px] font-semibold">₹2,000 saved this month</p>
    </div>
  </div>
</ProductStage>

<!-- Grokul -->
<ProductStage product={p('grokul')}>
  <div class="relative mx-auto flex h-[560px] max-w-[560px] items-center justify-center sm:h-[640px]">
    <div class="absolute size-[80%] rounded-full bg-[#6676E0]/25 blur-3xl"></div>
    <Phone class="relative w-[62%] max-w-[300px]">
      <div class="px-5 pt-3">
        <div class="flex items-center justify-between">
          <p class="text-[15px] font-semibold">Good evening, Riya</p>
          <span class="flex rounded-full bg-[#E7EAFB] p-0.5 text-[10px] font-semibold">
            <span class="rounded-full px-2 py-0.5 text-[#565E8C]">EN</span>
            <span lang="hi" class="rounded-full bg-[#3546A5] px-2 py-0.5 text-white">हिं</span>
          </span>
        </div>
        <div class="mt-4 rounded-2xl bg-gradient-to-br from-[#3546A5] to-[#6676E0] p-4 text-white">
          <p class="flex items-center gap-1.5 text-[11px] text-white/75"><BookOpen class="size-3.5" /> आज का पाठ · विज्ञान</p>
          <p lang="hi" class="mt-1 text-[19px] font-semibold">प्रकाश संश्लेषण</p>
          <p class="text-[11px] text-white/70">Photosynthesis</p>
          <div class="mt-3 h-1.5 rounded-full bg-white/25"><div class="h-1.5 w-[60%] rounded-full bg-white"></div></div>
        </div>
        <p lang="hi" class="mt-5 text-[13px] font-semibold">पौधे भोजन बनाने के लिए क्या लेते हैं?</p>
        <ul class="mt-3 space-y-2 text-[12px]">
          <li lang="hi" class="rounded-xl bg-[#DFF3E8] px-3 py-2.5 font-semibold text-[#0E6B43]">✓ धूप, पानी और कार्बन डाइऑक्साइड</li>
          <li lang="hi" class="rounded-xl bg-[#F3F4FA] px-3 py-2.5">सिर्फ़ मिट्टी</li>
          <li lang="hi" class="rounded-xl bg-[#F3F4FA] px-3 py-2.5">सिर्फ़ पानी</li>
        </ul>
      </div>
    </Phone>
    <div class="glass absolute top-[14%] right-0 flex items-center gap-2 rounded-full py-2 pr-4 pl-2 sm:right-[4%]">
      <span class="flex size-8 items-center justify-center rounded-full bg-[#F2B230] text-white"><Flame class="size-4" /></span>
      <span class="text-[13px] font-semibold">5-day streak</span>
    </div>
    <div class="glass absolute bottom-[14%] left-0 rounded-[22px] p-3 pr-5 sm:left-[2%]">
      <p class="text-[11px] opacity-60">Learn in</p>
      <p class="text-[15px] font-semibold">Hindi or English</p>
    </div>
  </div>
</ProductStage>

<!-- Paparazi -->
<ProductStage product={p('paparazi')} reverse>
  <div class="relative mx-auto flex h-[560px] max-w-[560px] items-center justify-center sm:h-[640px]">
    <div class="absolute size-[80%] rounded-full bg-[#EE5A8F]/25 blur-3xl"></div>
    <Phone class="relative w-[62%] max-w-[300px]">
      <div class="px-4 pt-2">
        <p class="text-center text-[13px] font-semibold">New post</p>
        <Image src={dhokla} alt="" width={500} class="mt-3 aspect-square w-full rounded-2xl object-cover" />
        <p class="mt-3 text-[12px] leading-snug">Fresh dhokla, every morning from 7. Order on WhatsApp.</p>
        <p class="mt-3 text-[10px] font-semibold tracking-wide text-[#8A5A48] uppercase">Share to</p>
        <div class="mt-2 flex gap-2">
          {
            ['siInstagram', 'siWhatsapp', 'siGoogle'].map((k) => (
              <span class="flex size-9 items-center justify-center rounded-xl bg-[#FFE7D8] text-[#3A160A]">
                <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true"><path d={icons[k]?.path} /></svg>
              </span>
            ))
          }
        </div>
        <span class="mt-4 flex h-10 items-center justify-center rounded-full bg-[#BE185D] text-[12px] font-semibold text-white">Schedule for 7:30 AM</span>
      </div>
    </Phone>
    <div class="glass absolute top-[12%] left-0 rounded-[22px] p-3 pr-5 sm:left-[2%]">
      <p class="text-[11px] opacity-60">Your shop</p>
      <p class="text-[15px] font-semibold">In your words</p>
    </div>
    <div class="glass absolute right-0 bottom-[14%] rounded-[22px] p-3 pr-5 sm:right-[2%]">
      <p class="text-[11px] opacity-60">One tap</p>
      <p class="text-[15px] font-semibold">Three channels</p>
    </div>
  </div>
</ProductStage>

<style>
  .beside-map {
    background:
      linear-gradient(90deg, rgb(255 255 255 / 0.05) 2px, transparent 2px) 0 0 / 46px 100%,
      linear-gradient(rgb(255 255 255 / 0.05) 2px, transparent 2px) 0 0 / 100% 54px,
      linear-gradient(35deg, transparent 47%, rgb(255 255 255 / 0.08) 48%, rgb(255 255 255 / 0.08) 52%, transparent 53%),
      #0b2122;
  }
  @media (prefers-reduced-motion: no-preference) {
    .plate-float {
      animation: plate-float 7s ease-in-out infinite;
      animation-delay: var(--d, 0s);
    }
  }
  @keyframes plate-float {
    50% {
      translate: 0 -10px;
    }
  }
</style>

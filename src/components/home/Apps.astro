---
import '@fontsource-variable/plus-jakarta-sans';
import { ArrowUpRight, Check } from '@lucide/astro';
import AppVisual from '../ui/AppVisual.astro';
import { products, productCta, statusLabel } from '../../data/products';

/*
 * One chapter per app, pinned while you scroll. The panel starts inside the page's container,
 * grows to fill the screen (the site header slides away), and each app appears in its own
 * design language: its colours, type, radius and background. At the end the panel shrinks
 * back into the container and the page carries on. Without JavaScript the apps simply stack.
 *
 * Plate follows its own design system (plate/docs/design-system.md): a mint, cream and peach
 * day, Plus Jakarta Sans and emerald pill buttons. The others use their rachna-kit brand
 * tokens (primary colour and radius) until their own systems are designed.
 */
interface Look {
  bg: string;
  soft: string;
  ink: string;
  accent: string;
  /** The page behind the app: a gradient in its colours. */
  page: string;
  font: string;
  weight: number;
  tracking: string;
  radius: string;
}

const jakarta = "'Plus Jakarta Sans Variable', 'Inter Variable', sans-serif";
const inter = "'Inter Variable', sans-serif";

const looks: Record<string, Look> = {
  plate: {
    bg: '#F1F8F3', soft: '#D8F1E4', ink: '#10241B', accent: '#12805A',
    page: 'radial-gradient(70% 60% at -8% 25%, #CDEEDD 0%, transparent 65%), radial-gradient(60% 55% at 108% 55%, #FDDCCB 0%, transparent 62%), linear-gradient(100deg, #E3F4EA 0%, #F6F7F1 50%, #FCEFE5 100%)',
    font: jakarta, weight: 600, tracking: '-0.035em', radius: '999px',
  },
  grokul: {
    bg: '#F6F6FB', soft: '#E2E0F8', ink: '#1E1B4B', accent: '#4338CA',
    page: 'linear-gradient(rgb(67 56 202 / 0.06) 1px, transparent 1px) 0 0 / 100% 36px, radial-gradient(60% 70% at 85% 40%, #E2E0F8 0%, transparent 70%), #F6F6FB',
    font: inter, weight: 500, tracking: '-0.04em', radius: '14px',
  },
  beside: {
    bg: '#F4F9F8', soft: '#D5ECE9', ink: '#042F2E', accent: '#0F766E',
    page: 'radial-gradient(55% 65% at 80% 45%, #CFEAE6 0%, transparent 70%), radial-gradient(40% 50% at 10% 90%, #E6F4F1 0%, transparent 70%), #F4F9F8',
    font: inter, weight: 400, tracking: '-0.04em', radius: '18px',
  },
  balance: {
    bg: '#F5F8FF', soft: '#DCE8FD', ink: '#0B1E3F', accent: '#1868F0',
    page: 'linear-gradient(90deg, rgb(24 104 240 / 0.05) 1px, transparent 1px) 0 0 / 48px 100%, linear-gradient(rgb(24 104 240 / 0.05) 1px, transparent 1px) 0 0 / 100% 48px, radial-gradient(55% 65% at 80% 45%, #DCE8FD 0%, transparent 70%), #F5F8FF',
    font: inter, weight: 300, tracking: '-0.045em', radius: '12px',
  },
  paparazi: {
    bg: '#FCF6F9', soft: '#F7DCE9', ink: '#500724', accent: '#BE185D',
    page: 'radial-gradient(45% 55% at 80% 30%, #F9CFE1 0%, transparent 70%), radial-gradient(40% 50% at 65% 85%, #FBE2D3 0%, transparent 70%), #FCF6F9',
    font: inter, weight: 800, tracking: '-0.05em', radius: '24px',
  },
};
const order = ['plate', 'grokul', 'beside', 'balance', 'paparazi'];

/*
 * Each app has its own layout. The visual area of each layout carries a shape (circle,
 * rounded card, pill...) and the shared backdrop morphs from one shape and place to the
 * next as you scroll, like Keynote's Magic Move.
 */
const layouts: Record<string, { layout: string; shape: string; radius: string; tilt: number }> = {
  plate: { layout: 'right', shape: 'circle', radius: '50%', tilt: 0 },
  grokul: { layout: 'stack', shape: 'pill', radius: '40px', tilt: 0 },
  beside: { layout: 'left', shape: 'circle', radius: '50%', tilt: 0 },
  balance: { layout: 'card', shape: 'card', radius: '36px', tilt: 0 },
  paparazi: { layout: 'poster', shape: 'card', radius: '44px', tilt: 3 },
};
const items = [...products]
  .sort((a, b) => order.indexOf(a.key) - order.indexOf(b.key))
  .map((p) => ({ product: p, look: looks[p.key] ?? looks.plate, layout: layouts[p.key] ?? layouts.plate, cta: productCta(p) }));
const vars = (l: Look) =>
  `--bg: ${l.bg}; --soft: ${l.soft}; --ink: ${l.ink}; --accent: ${l.accent}; --app-font: ${l.font}; --app-weight: ${l.weight}; --app-tracking: ${l.tracking}; --app-radius: ${l.radius}`;
---

<section id="apps" class="apps relative scroll-mt-20" style={`--count: ${items.length}`} aria-label="Our apps">
  <div class="apps-sticky">
    <div data-apps-panel class="apps-panel">
      {items.map((it, i) => <div class:list={['app-page', i === 0 && 'is-active']} data-app-page={i} style={`background: ${it.look.page}`} />)}

      <div class="apps-inner container-x">
        <div class="apps-stack relative">
          <span data-morph class="morph" aria-hidden="true"></span>
          {
            items.map((it, i) => (
              <article
                id={`app-${it.product.key}`}
                data-app={i}
                data-soft={it.look.soft}
                style={`${vars(it.look)}; --slide-page: ${it.look.page}`}
                class:list={['app-slide', `layout-${it.layout.layout}`, `app-${it.product.key}`, i === 0 && 'is-active']}
              >
                <div class="app-copy">
                  <p class="flex flex-wrap items-center gap-3 text-[13px]">
                    <span class="app-tag">{it.product.category}</span>
                    <span class="opacity-60">{statusLabel[it.product.status]} · {it.product.platforms}</span>
                  </p>
                  <h3 class="app-name mt-5">{it.product.name}</h3>
                  <p class="app-tagline mt-4">{it.product.tagline}.</p>
                  <p class="app-desc mt-4 text-[16px] leading-relaxed opacity-70">{it.product.description}</p>
                  <ul class="app-features mt-6 flex flex-wrap gap-x-6 gap-y-2 text-[14px]">
                    {it.product.features.map((f) => (
                      <li class="flex items-center gap-2">
                        <Check class="size-4 text-[var(--accent)]" stroke-width={2.4} />
                        {f}
                      </li>
                    ))}
                  </ul>
                  <a
                    href={it.cta.href}
                    {...(it.cta.external ? { target: '_blank', rel: 'noopener noreferrer' } : { 'data-topic': 'Product enquiry', 'data-product': it.product.name })}
                    class="app-cta mt-8"
                  >
                    {it.cta.external ? it.cta.label : 'Get notified'}
                    <span class="app-cta-icon"><ArrowUpRight class="size-4" /></span>
                  </a>
                </div>

                <div class="app-visual" data-visual data-radius={it.layout.radius} data-tilt={it.layout.tilt}>
                  <AppVisual app={it.product.key} />
                </div>
              </article>
            ))
          }
        </div>

        <div class="apps-progress flex items-center gap-4 px-2 pb-8 sm:px-6 lg:px-10" aria-hidden="true">
          <span class="text-[13px] tabular-nums"><span data-app-count>01</span><span class="opacity-40"> / {String(items.length).padStart(2, '0')}</span></span>
          <span class="flex flex-1 gap-1.5">
            {items.map((_, i) => <span class="seg" data-seg={i}><span /></span>)}
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @property --ink {
    syntax: '<color>';
    inherits: true;
    initial-value: #111111;
  }

  .apps-panel {
    color: var(--ink);
  }
  .app-slide {
    color: var(--ink);
    padding-block: 4rem;
  }
  .morph {
    z-index: 0;
  }
  .app-slide {
    z-index: 1;
  }

  /* Each app's own type and shapes */
  .app-name {
    font-family: var(--app-font);
    font-weight: var(--app-weight);
    letter-spacing: var(--app-tracking);
    font-size: clamp(3.4rem, 8vw, 6.6rem);
    line-height: 0.95;
  }
  .app-tagline {
    font-family: var(--app-font);
    font-size: clamp(1.3rem, 2.2vw, 1.75rem);
    line-height: 1.25;
    font-weight: 400;
    letter-spacing: -0.015em;
    color: var(--accent);
  }
  .app-tag {
    border-radius: var(--app-radius);
    background: var(--soft);
    color: var(--accent);
    padding: 4px 12px;
    font-weight: 500;
  }
  .app-cta {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    height: 52px;
    padding: 0 8px 0 22px;
    border-radius: var(--app-radius);
    background: var(--accent);
    color: #fff;
    font-family: var(--app-font);
    font-size: 15px;
    font-weight: 600;
    transition: transform 0.2s, filter 0.2s;
  }
  .app-cta:hover {
    transform: translateY(-1px);
    filter: brightness(1.08);
  }
  .app-cta-icon {
    display: flex;
    width: 36px;
    height: 36px;
    align-items: center;
    justify-content: center;
    border-radius: calc(var(--app-radius) * 0.8);
    background: rgb(255 255 255 / 0.18);
  }
  /* Plate: emerald pill with a white circle and a green glow, from its design system. */
  .app-plate .app-cta-icon {
    border-radius: 999px;
    background: #fff;
    color: #12805a;
  }
  .app-plate .app-copy p,
  .app-plate .app-copy li {
    font-family: var(--app-font);
  }
  /* Paparazi: bold display type */
  .app-paparazi .app-tagline {
    font-weight: 700;
  }

  /* Layouts. On small screens every app stacks: words, then its visual. */
  .app-slide {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    padding-inline: 0.5rem;
  }
  .app-visual {
    position: relative;
    width: min(100%, 420px);
    aspect-ratio: 1;
    margin-inline: auto;
    border-radius: 32px;
    background: var(--soft);
  }
  .app-desc {
    max-width: 32rem;
  }
  @media (min-width: 1024px) {
    .app-slide {
      display: grid;
      align-items: center;
      gap: 4rem;
      padding-inline: 2.5rem;
    }
    :global(.js) .app-visual {
      background: transparent;
    }
    .app-visual {
      width: auto;
      margin: 0;
    }
    /* Plate: words left, a round visual right */
    .layout-right {
      grid-template-columns: 1fr 1fr;
    }
    .layout-right .app-visual {
      height: min(62vh, 560px);
      aspect-ratio: 1;
      justify-self: center;
    }
    /* Grokul: centred words, a wide lesson strip below */
    .layout-stack {
      grid-template-columns: 1fr;
      justify-items: center;
      align-content: center;
      gap: 2.25rem;
      text-align: center;
    }
    .layout-stack .app-copy {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .layout-stack .app-name {
      font-size: clamp(3rem, 6vw, 5rem);
    }
    .layout-stack .app-desc {
      display: none;
    }
    .layout-stack .app-features {
      justify-content: center;
    }
    .layout-stack .app-visual {
      height: min(46vh, 420px);
      aspect-ratio: 16 / 10;
    }
    /* Beside: a round map left, words right */
    .layout-left {
      grid-template-columns: 1fr 1fr;
    }
    .layout-left .app-visual {
      order: -1;
      height: min(64vh, 580px);
      aspect-ratio: 1;
      justify-self: center;
    }
    /* Balance: words left, a tall card right */
    .layout-card {
      grid-template-columns: 1.2fr 0.8fr;
    }
    .layout-card .app-visual {
      height: min(70vh, 620px);
      aspect-ratio: 4 / 5;
      justify-self: end;
    }
    /* Paparazi: an oversized bold name that runs over the tilted post */
    .layout-poster {
      grid-template-columns: 0.9fr 1.1fr;
    }
    .layout-poster .app-name {
      font-size: clamp(4rem, 8vw, 7.5rem);
      line-height: 0.88;
    }
    .layout-poster .app-visual {
      height: min(68vh, 600px);
      aspect-ratio: 1;
      justify-self: center;
    }
  }

  /* Pinned on a small screen: keep each app to one screen. */
  @media (max-width: 1023px) {
    :global(.js) .app-slide {
      gap: 1.5rem;
      padding-block: 1.5rem 3.5rem;
      justify-content: center;
    }
    :global(.js) .app-desc,
    :global(.js) .app-features {
      display: none;
    }
    :global(.js) .app-visual {
      width: auto;
      height: min(38vh, 340px);
    }
    .app-name {
      font-size: clamp(3rem, 14vw, 4.5rem);
    }
  }

  /* The shared backdrop that morphs between layouts */
  .morph {
    display: none;
  }
  @media (min-width: 1024px) {
    :global(.js) .morph {
      display: block;
      position: absolute;
      left: 0;
      top: 0;
      width: 0;
      height: 0;
      background: var(--morph-bg, #eee);
      transition:
        transform 1.1s cubic-bezier(0.65, 0, 0.35, 1),
        width 1.1s cubic-bezier(0.65, 0, 0.35, 1),
        height 1.1s cubic-bezier(0.65, 0, 0.35, 1),
        border-radius 1.1s cubic-bezier(0.65, 0, 0.35, 1),
        background-color 0.9s ease;
    }
  }

  /* Without JavaScript: the apps stack, each on its own page. */
  html:not(.js) .app-slide {
    background: var(--slide-page);
  }
  .app-page,
  .apps-progress {
    display: none;
  }

  /* With JavaScript: one pinned panel, driven by scroll. */
  :global(.js) .apps {
    height: calc((var(--count) * 55 + 190) * 1vh);
  }
  :global(.js) .apps-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }
  :global(.js) .apps-panel {
    position: absolute;
    inset: 0;
    background: #fff;
    clip-path: inset(var(--inset-y, 9vh) var(--inset-x, 3.5vw) round var(--radius, 32px));
  }
  :global(.js) .app-page {
    display: block;
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.9s cubic-bezier(0.4, 0, 0.2, 1);
  }
  :global(.js) .app-page.is-active {
    opacity: 1;
  }
  :global(.js) .apps-inner {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    scale: var(--content-scale, 0.94);
    transform-origin: 50% 45%;
  }
  :global(.js) .apps-stack {
    flex: 1;
  }
  :global(.js) .app-slide {
    position: absolute;
    inset: 0;
    padding-block: 3rem;
    opacity: 0;
    translate: 0 40px;
    pointer-events: none;
    transition:
      opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      translate 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  :global(.js) .app-slide.is-active {
    opacity: 1;
    translate: none;
    pointer-events: auto;
    transition-delay: 0.12s;
  }
  :global(.js) .app-slide.is-past {
    translate: 0 -40px;
  }
  .app-visual :global(.visual) {
    transition:
      scale 0.9s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.6s ease;
  }
  :global(.js) .app-slide:not(.is-active) .app-visual :global(.visual) {
    scale: 0.85;
    opacity: 0;
  }

  :global(.js) .apps-progress {
    display: flex;
    color: var(--ink);
  }
  .seg {
    position: relative;
    height: 2px;
    flex: 1;
    overflow: hidden;
    border-radius: 2px;
    background: color-mix(in srgb, currentColor 15%, transparent);
  }
  .seg > span {
    position: absolute;
    inset: 0;
    background: currentColor;
    transform-origin: left;
    scale: var(--fill, 0) 1;
  }

  /* While the section fills the screen, the site header steps aside. */
  :global(html.apps-immersive #site-header) {
    translate: 0 -100%;
  }
  :global(#site-header) {
    transition:
      translate 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.3s;
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('.apps');
  const panel = section?.querySelector<HTMLElement>('[data-apps-panel]');
  const slides = section ? [...section.querySelectorAll<HTMLElement>('[data-app]')] : [];
  const pages = section ? [...section.querySelectorAll<HTMLElement>('[data-app-page]')] : [];
  const segs = section ? [...section.querySelectorAll<HTMLElement>('[data-seg]')] : [];
  const counter = section?.querySelector<HTMLElement>('[data-app-count]');
  const progress = section?.querySelector<HTMLElement>('.apps-progress');
  const morph = section?.querySelector<HTMLElement>('[data-morph]');
  const stack = section?.querySelector<HTMLElement>('.apps-stack');

  if (section && panel && slides.length) {
    const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
    let active = -1;

    const setActive = (i: number) => {
      if (i === active) return;
      active = i;
      slides.forEach((s, j) => {
        s.classList.toggle('is-active', j === i);
        s.classList.toggle('is-past', j < i);
        s.inert = j !== i;
      });
      pages.forEach((p, j) => p.classList.toggle('is-active', j === i));
      moveMorph();
      if (progress) progress.style.setProperty('--ink', getComputedStyle(slides[i]).getPropertyValue('--ink'));
      if (counter) counter.textContent = String(i + 1).padStart(2, '0');
    };

    // Position of an element relative to the stack, ignoring transforms (offsets only).
    const offsetIn = (el: HTMLElement, root: HTMLElement) => {
      let x = 0;
      let y = 0;
      let node: HTMLElement | null = el;
      while (node && node !== root) {
        x += node.offsetLeft;
        y += node.offsetTop;
        node = node.offsetParent as HTMLElement | null;
      }
      return { x, y };
    };
    function moveMorph() {
      if (!morph || !stack || active < 0) return;
      const visual = slides[active].querySelector<HTMLElement>('[data-visual]');
      if (!visual) return;
      const { x, y } = offsetIn(visual, stack);
      morph.style.width = `${visual.offsetWidth}px`;
      morph.style.height = `${visual.offsetHeight}px`;
      morph.style.borderRadius = visual.dataset.radius ?? '32px';
      morph.style.transform = `translate(${x}px, ${y}px) rotate(${visual.dataset.tilt ?? 0}deg)`;
      morph.style.setProperty('--morph-bg', slides[active].dataset.soft ?? '#eee');
    }

    let frame = 0;
    const update = () => {
      frame = 0;
      const vh = window.innerHeight;
      const scrolled = -section.getBoundingClientRect().top;
      const total = section.offsetHeight - vh;
      const grow = vh * 0.45;
      const shrink = vh * 0.45;

      // 0 = inside the container, 1 = full screen.
      let open: number;
      if (scrolled < grow) open = Math.max(0, scrolled / grow);
      else if (scrolled > total - shrink) open = Math.max(0, (total - scrolled) / shrink);
      else open = 1;
      const e = ease(Math.min(1, open));
      const gutter = Math.min(window.innerWidth * 0.035, 56);
      panel.style.setProperty('--inset-y', `${(1 - e) * vh * 0.09}px`);
      panel.style.setProperty('--inset-x', `${(1 - e) * gutter}px`);
      panel.style.setProperty('--radius', `${(1 - e) * 32}px`);
      panel.style.setProperty('--content-scale', String(0.94 + e * 0.06));
      document.documentElement.classList.toggle('apps-immersive', open > 0.92);

      const middle = Math.max(1, total - grow - shrink);
      const into = Math.min(middle - 1, Math.max(0, scrolled - grow));
      const pos = (into / middle) * slides.length;
      setActive(Math.min(slides.length - 1, Math.floor(pos)));
      segs.forEach((s, j) => s.style.setProperty('--fill', String(Math.min(1, Math.max(0, pos - j)))));
    };
    const onScroll = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };
    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', () => {
      onScroll();
      moveMorph();
    });
    window.addEventListener('load', moveMorph);
  }
</script>

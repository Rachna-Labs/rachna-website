---
import { MessageCircleQuestion, Plus } from '@lucide/astro';
import { faqs } from '../../data/faqs';
import { site } from '../../config/site';
---

<section id="faq" class="scroll-mt-20 border-t border-line py-20 sm:py-28">
  <div class="container-x">
    <div class="grid gap-10 px-2 sm:px-6 lg:grid-cols-[1fr_1.6fr] lg:gap-24 lg:px-10">
      <div data-reveal>
        <p class="chip"><span class="chip-icon"><MessageCircleQuestion class="size-3.5" /></span>FAQ</p>
        <h2 class="mt-6 font-display text-[2.4rem] leading-[1.08] font-light tracking-[-0.035em] sm:text-[3.2rem]">Questions, <span class="accent-italic">answered</span></h2>
        <p class="section-lead mt-5 max-w-sm">
          Still curious? Write to us at <a href={`mailto:${site.email}`} class="text-blue hover:underline">{site.email}</a>.
        </p>
      </div>
      <div class="divide-y divide-line border-y border-line" data-reveal>
        {
          faqs.map((faq, i) => (
            <details class="group" name="faq" open={i === 0}>
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-left text-[17px] font-normal tracking-[-0.01em] [&::-webkit-details-marker]:hidden">
                {faq.q}
                <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-tile transition-all duration-300 group-open:rotate-45 group-open:bg-blue group-open:text-white">
                  <Plus class="size-4" />
                </span>
              </summary>
              <p class="pr-10 pb-5 text-[14px] leading-relaxed text-muted-foreground">{faq.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>

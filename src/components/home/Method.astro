---
import { Sparkles } from '@lucide/astro';
import Geometry from '../ui/Geometry.astro';

const steps = [
  { shape: 'sphere' as const, title: 'Observe first.', body: 'We start with people, not features. Weeks of listening before a single screen.' },
  { shape: 'cubes' as const, title: 'Prototype small.', body: 'Many quick experiments. Most are discarded, and only the best ideas get built.' },
  { shape: 'warp' as const, title: 'Prove it.', body: 'Nothing ships without evidence: sourced data, real tests and honest results.' },
];
---

<section id="method" class="scroll-mt-20 border-t border-line py-20 sm:py-28">
  <div class="container-x">
    <div class="text-center" data-reveal>
      <p class="chip"><span class="chip-icon"><Sparkles class="size-3.5" /></span>Method</p>
      <h2 class="mt-6 font-display text-[2.4rem] leading-[1.08] font-light tracking-[-0.035em] sm:text-[3.2rem]"><span class="accent-italic">One method</span> behind everything we make</h2>
    </div>

    <div class="mt-16 grid gap-12 px-2 sm:px-6 md:grid-cols-3 md:gap-8 lg:px-10">
      {
        steps.map((s, i) => (
          <article class="flex flex-col" data-reveal style={`--reveal-delay: ${i * 90}ms`}>
            <div class="dots fade-dots flex h-64 items-center justify-center">
              <Geometry shape={s.shape} class="h-56 w-auto max-w-full" />
            </div>
            <span class="mt-8 text-[13px] text-blue tabular-nums">0{i + 1}</span>
            <h3 class="mt-2 text-[21px] font-light tracking-[-0.015em]">{s.title}</h3>
            <p class="mt-2 max-w-sm text-[15px] leading-relaxed text-muted-foreground">{s.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

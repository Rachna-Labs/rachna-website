---
import { ArrowUpRight, Mail, Send } from '@lucide/astro';
import { site } from '../../config/site';

const endpoint = site.contactFormEndpoint;
---

<section id="contact" class="scroll-mt-20 border-t border-line py-20 sm:py-28">
  <div class="container-x">
    <div class="grid gap-12 px-2 sm:px-6 lg:grid-cols-[1fr_1.1fr] lg:gap-24 lg:px-10" data-reveal>
      <div>
        <p class="chip"><span class="chip-icon"><Send class="size-3.5" /></span>Contact</p>
        <h2 class="mt-6 font-display text-[2.4rem] leading-[1.08] font-light tracking-[-0.035em] sm:text-[3.2rem]">
          Let’s build what India <span class="accent-italic">needs next</span>
        </h2>
        <p class="section-lead mt-5 max-w-sm">Tell us what you are working on. We read every message and reply within a day.</p>
        <a href={`mailto:${site.email}`} class="mt-8 inline-flex items-center gap-2.5 text-[15px] text-ink hover:text-blue">
          <Mail class="size-4" />{site.email}
        </a>
      </div>

      <form
        id="contact-form"
        class="grid gap-7"
        action={endpoint || `mailto:${site.email}`}
        method="post"
        enctype={endpoint ? undefined : 'text/plain'}
        data-endpoint={endpoint}
        data-email={site.email}
      >

        <div class="grid gap-7 sm:grid-cols-2">
          <div>
            <label for="cf-name" class="field-label">Name</label>
            <input id="cf-name" name="name" type="text" autocomplete="name" required maxlength="120" class="field" />
          </div>
          <div>
            <label for="cf-email" class="field-label">Email</label>
            <input id="cf-email" name="email" type="email" autocomplete="email" required maxlength="160" class="field" />
          </div>
        </div>
        <div>
          <label for="cf-message" class="field-label">Message</label>
          <textarea id="cf-message" name="message" rows="3" required minlength="10" maxlength="4000" class="field"></textarea>
        </div>

        <input type="hidden" name="topic" value="General enquiry" />
        <input type="hidden" name="product" value="" />
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />

        <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
          <label class="flex items-center gap-2.5 text-[12.5px] text-muted-foreground">
            <input type="checkbox" name="consent" required class="size-3.5 shrink-0 accent-[#111111]" />
            <span>I agree to the <a href="/privacy-policy/" class="underline underline-offset-2 hover:text-ink">Privacy Policy</a>.</span>
          </label>
          <button type="submit" class="btn btn-primary btn-lg shrink-0 disabled:cursor-wait disabled:opacity-70">
            Send message <ArrowUpRight class="size-4" />
          </button>
        </div>

        <p id="form-status" role="status" aria-live="polite" hidden class="rounded-[12px] border px-4 py-3 text-sm"></p>
      </form>
    </div>
  </div>
</section>

<style>
  .field-label {
    display: block;
    font-size: 12.5px;
    color: var(--color-muted-foreground);
  }
  .field {
    width: 100%;
    height: 44px;
    border: 0;
    border-bottom: 1px solid var(--color-line);
    background: transparent;
    padding: 0;
    font-size: 16px;
    color: var(--color-ink);
    transition: border-color 0.2s;
  }
  textarea.field {
    height: auto;
    min-height: 88px;
    padding-top: 10px;
    resize: vertical;
  }
  .field:hover {
    border-bottom-color: #c9c9c9;
  }
  .field:focus {
    outline: none;
    border-bottom-color: var(--color-ink);
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;

  if (form) {
    const status = form.querySelector<HTMLElement>('#form-status')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const topicField = form.querySelector<HTMLInputElement>('input[name="topic"]')!;
    const productField = form.querySelector<HTMLInputElement>('input[name="product"]')!;
    const endpoint = form.dataset.endpoint;
    const email = form.dataset.email ?? '';

    // Links elsewhere on the page (product cards, "Partner with us", etc.) pre-fill the form.
    document.addEventListener('click', (event) => {
      const trigger = (event.target as Element | null)?.closest<HTMLElement>('[data-topic], [data-product]');
      if (!trigger) return;
      const { topic, product } = trigger.dataset;
      if (topic) topicField.value = topic;
      productField.value = product ?? '';
    });

    const show = (message: string, ok: boolean) => {
      status.textContent = message;
      status.hidden = false;
      status.className = `rounded-[12px] border px-4 py-3 text-sm ${ok ? 'border-[#CFE6D6] bg-[#F1F8F3] text-[#1D6B3E]' : 'border-[#F1D2CE] bg-[#FDF3F2] text-[#8E2414]'}`;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const data = new FormData(form);
      if (data.get('_gotcha')) return;

      if (endpoint) {
        button.disabled = true;
        try {
          const res = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
          if (!res.ok) throw new Error(String(res.status));
          form.reset();
          show("Thank you! Your message has been sent. We'll reply within one business day.", true);
        } catch {
          show(`Sorry, something went wrong. Please email us directly at ${email}.`, false);
        } finally {
          button.disabled = false;
        }
        return;
      }

      const field = (name: string) => String(data.get(name) ?? '').trim() || '-';
      const subject = `${field('topic')}: ${field('name')}`;
      const body = [
        `Name: ${field('name')}`,
        `Email: ${field('email')}`,
        `Topic: ${field('topic')}`,
        `Product: ${field('product')}`,
        '',
        field('message'),
      ].join('\n');

      window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      show(`Your email app should open with your message ready to send. If it doesn't, write to us at ${email}.`, true);
    });
  }
</script>

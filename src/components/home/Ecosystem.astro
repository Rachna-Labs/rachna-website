---
import AppIcon from '../ui/AppIcon.astro';
import { products, statusLabel } from '../../data/products';

const connected = new Set(['sakhi', 'plate', 'paid']);

const swatches = [
  { name: 'Sindoor', hex: '#E0532F' },
  { name: 'Haldi', hex: '#F2B230' },
  { name: 'Genda', hex: '#EE8524' },
  { name: 'Rani', hex: '#D1336F' },
  { name: 'Neel', hex: '#3546A5' },
  { name: 'Mor', hex: '#0E8582' },
  { name: 'Mehendi', hex: '#5E8C31' },
];

const snippets = [
  { id: 'swiftui', label: 'SwiftUI', note: 'iPhone, iPad, Watch', code: `PlateApp()\n    .rachnaBrand(RachnaBrands.plate)` },
  { id: 'compose', label: 'Compose', note: 'Android', code: `RachnaTheme(RachnaBrands.plate) {\n    PlateApp()\n}` },
  { id: 'css', label: 'CSS', note: 'The web', code: `@import "rachna-kit/css/plate.css";\n\n.button { background: var(--color-primary); }` },
];
---

<section id="ecosystem" data-theme="paper" class="scroll-mt-12 py-28 sm:py-40">
  <div class="container-x">
    <div class="mx-auto max-w-3xl text-center" data-reveal>
      <p class="text-muted text-[15px] font-medium sm:text-[17px]">The ecosystem</p>
      <h2 class="mt-3 font-display text-[2.6rem] leading-[1.05] font-semibold tracking-[-0.04em] sm:text-[4rem]">
        One account. <span class="text-gradient">One design language.</span>
      </h2>
      <p class="text-muted mx-auto mt-5 max-w-xl text-lg leading-relaxed sm:text-[21px]">
        Our apps are not strangers to each other. They share how you sign in, how they look and how they are built.
      </p>
    </div>

    <div class="mt-16 grid gap-5 sm:mt-20 lg:grid-cols-2">
      <article class="eco-card flex flex-col overflow-hidden rounded-[36px] p-7 sm:p-10" data-reveal>
        <div class="flex items-center gap-2.5">
          <h3 class="text-[15px] font-semibold">Rachna Account</h3>
          <span class="rounded-full bg-white/70 px-2.5 py-0.5 text-xs font-medium">Being built</span>
        </div>
        <p class="mt-3 font-display text-[2rem] leading-[1.08] font-semibold tracking-[-0.035em]">Sign in once. Every app knows you.</p>
        <p class="text-muted mt-3 max-w-md text-[17px] leading-relaxed">Your name, language and settings follow you. You decide what each app can see.</p>

        <div class="glass mt-10 rounded-[28px] p-5 sm:mx-4 sm:p-6" aria-hidden="true">
          <div class="flex items-center gap-3">
            <span class="flex size-11 items-center justify-center rounded-full bg-gradient-to-br from-sindoor to-rani font-semibold text-white">A</span>
            <div>
              <p class="text-[15px] font-semibold"><span lang="hi">नमस्ते</span>, Aarav</p>
              <p class="text-muted text-[13px]">aarav@example.com</p>
            </div>
          </div>
          <ul class="mt-5 space-y-1">
            {
              products.map((p) => {
                const on = connected.has(p.key);
                return (
                  <li class="flex items-center gap-3 rounded-2xl px-1 py-2">
                    <AppIcon product={p} class="size-9" />
                    <span class="flex-1">
                      <span class="block text-sm font-semibold">{p.name}</span>
                      <span class="text-muted block text-xs">{statusLabel[p.status]}</span>
                    </span>
                    <span class:list={['relative h-6 w-10 rounded-full transition-colors', on ? 'bg-ink' : 'bg-black/10']}>
                      <span class:list={['absolute top-0.5 size-5 rounded-full bg-white shadow', on ? 'right-0.5' : 'left-0.5']} />
                    </span>
                  </li>
                );
              })
            }
          </ul>
        </div>
      </article>

      <article id="kit" class="kit-card flex flex-col overflow-hidden rounded-[36px] p-7 text-white sm:p-10" data-reveal style="--reveal-delay: 100ms">
        <div class="flex items-center gap-2.5">
          <h3 class="text-[15px] font-semibold">Rachna Kit</h3>
          <span class="rounded-full bg-white/15 px-2.5 py-0.5 text-xs font-medium">In use</span>
        </div>
        <p class="mt-3 font-display text-[2rem] leading-[1.08] font-semibold tracking-[-0.035em]">Written once. Native everywhere.</p>
        <p class="mt-3 max-w-md text-[17px] leading-relaxed text-white/65">
          Colours, type, spacing and motion live in one place, then become SwiftUI, Jetpack Compose and CSS. Each app keeps its own colours.
        </p>

        <ul class="mt-10 grid grid-cols-7 gap-2 sm:gap-3" aria-label="Rachna palette">
          {
            swatches.map((s) => (
              <li class="flex flex-col items-center gap-2">
                <span class="block aspect-[3/4] w-full rounded-2xl" style={`background-color: ${s.hex}`} />
                <span class="text-[10.5px] text-white/60 sm:text-xs">{s.name}</span>
              </li>
            ))
          }
        </ul>

        <div class="mt-8" data-kit-tabs>
          <div class="flex gap-1 rounded-full bg-white/10 p-1" role="tablist" aria-label="Platform">
            {
              snippets.map((s, i) => (
                <button
                  type="button"
                  role="tab"
                  id={`kit-tab-${s.id}`}
                  aria-controls={`kit-panel-${s.id}`}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  class="flex-1 rounded-full px-3 py-1.5 text-[13px] font-medium text-white/60 transition-colors aria-selected:bg-white aria-selected:text-ink"
                >
                  {s.label}
                </button>
              ))
            }
          </div>
          {
            snippets.map((s, i) => (
              <div id={`kit-panel-${s.id}`} role="tabpanel" aria-labelledby={`kit-tab-${s.id}`} hidden={i !== 0} class="mt-3">
                <pre class="overflow-x-auto rounded-2xl bg-black/40 p-4 font-mono text-[12.5px] leading-relaxed text-[#F2E9DA]"><code>{s.code}</code></pre>
                <p class="mt-2 text-xs text-white/50">{s.note}</p>
              </div>
            ))
          }
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .eco-card {
    background: linear-gradient(160deg, #fde7dc, #fbe3ec 55%, #e9e4fb);
  }
  .kit-card {
    background:
      radial-gradient(60% 50% at 100% 0%, rgb(209 51 111 / 0.35), transparent 70%),
      radial-gradient(60% 60% at 0% 100%, rgb(53 70 165 / 0.45), transparent 70%),
      #12101c;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-kit-tabs]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    tabs.forEach((tab) =>
      tab.addEventListener('click', () => {
        tabs.forEach((t) => {
          const selected = t === tab;
          t.setAttribute('aria-selected', String(selected));
          const panel = root.querySelector<HTMLElement>(`#${t.getAttribute('aria-controls')}`);
          if (panel) panel.hidden = !selected;
        });
      }),
    );
  });
</script>

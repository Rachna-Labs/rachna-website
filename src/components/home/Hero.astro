---
import { ArrowRight, Atom } from '@lucide/astro';

/*
 * The lab's core: a slowly turning sphere made of dots. Small dots leave it and travel
 * along circuit traces to both edges of the screen, like ideas going out into the world.
 *
 * Traces are drawn on a 1600 × 420 stage centred on the sphere (800, 230). Each trace is
 * defined for the right side and mirrored for the left. The SVG draws the traces; a canvas
 * on the same stage draws the sphere and the moving dots.
 */
const W = 1600;
const H = 420;
const cx = 800;

type Pt = [number, number];
const right: Pt[][] = [
  [[920, 230], [1600, 230]],
  [[910, 190], [1010, 190], [1050, 150], [1260, 150], [1290, 120], [1600, 120]],
  [[910, 270], [1000, 270], [1040, 310], [1330, 310], [1360, 340], [1600, 340]],
  [[880, 150], [940, 90], [1120, 90], [1150, 60], [1600, 60]],
  [[880, 310], [930, 360], [1180, 360], [1210, 390], [1600, 390]],
  [[930, 210], [1130, 210], [1160, 180], [1420, 180], [1450, 205], [1600, 205]],
  [[930, 250], [1100, 250], [1130, 275], [1470, 275], [1500, 255], [1600, 255]],
];
const mirror = (pts: Pt[]): Pt[] => pts.map(([x, y]) => [2 * cx - x, y]);
const traces = [...right, ...right.map(mirror)];
const d = (pts: Pt[]) => `M${pts.map(([x, y]) => `${x} ${y}`).join(' L')}`;
// Vias: a few of the corners where a trace changes direction.
const vias = traces.flatMap((pts) => pts.slice(1, -1).filter((_, i) => i % 2 === 1));
---

<section id="top" class="hero relative overflow-hidden">
  <div class="relative container-text pt-24 text-center sm:pt-32 lg:pt-36">
    <p class="chip"><span class="chip-icon"><Atom class="size-3.5" /></span>An Indian research and product lab</p>
    <h1 class="mx-auto mt-7 max-w-3xl font-display text-[2.6rem] leading-[1.08] font-light tracking-[-0.035em] text-ink sm:text-[3.5rem] lg:text-[4rem]">
      Research that turns into technology for <span class="accent-italic">people</span>
    </h1>
    <p class="mx-auto mt-6 max-w-xl text-[16px] leading-relaxed text-muted-foreground">
      Rachna Labs studies everyday problems in India, from food and learning to safety and money, and turns what we learn into calm, careful technology.
    </p>
    <div class="mt-9 flex flex-wrap items-center justify-center gap-x-6 gap-y-3">
      <a href="/#research" class="btn btn-primary btn-lg">Explore our research</a>
      <a href="/#method" class="text-link">How we work <ArrowRight class="size-4" /></a>
    </div>
  </div>

  <!-- The energy core -->
  <div class="energy-stage relative mt-4 h-[640px] sm:mt-6" aria-hidden="true">
    <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" class="absolute inset-0 size-full" fill="none">
      <defs>
        <linearGradient id="trace-fade" x1="0" y1="0" x2="1600" y2="0" gradientUnits="userSpaceOnUse">
          <stop stop-color="#EFEFEF" stop-opacity="0" />
          <stop offset="0.22" stop-color="#E2E2E2" />
          <stop offset="0.5" stop-color="#D4D4D4" />
          <stop offset="0.78" stop-color="#E2E2E2" />
          <stop offset="1" stop-color="#EFEFEF" stop-opacity="0" />
        </linearGradient>
      </defs>

      {traces.map((pts) => <path d={d(pts)} stroke="url(#trace-fade)" stroke-width="1.2" stroke-linejoin="round" />)}
      {vias.map(([x, y]) => <circle cx={x} cy={y} r="2.6" fill="#fff" stroke="#D4D4D4" stroke-width="1.1" />)}
    </svg>

    <span class="sphere-glow absolute top-[350px] left-1/2 -translate-x-1/2 -translate-y-1/2"></span>
    <canvas data-sphere data-traces={JSON.stringify(traces)} class="absolute inset-0 size-full"></canvas>
  </div>
</section>

<style>
  .hero {
    background: #ffffff;
  }
  /* Everything in the energy stage dissolves into the page: no hard edges at the bottom or sides. */
  .energy-stage {
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 80%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 80%, transparent 100%);
  }

  .sphere-glow {
    width: min(640px, 100vw);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(236 236 236 / 0.7), rgb(244 244 244 / 0.35) 55%, rgb(255 255 255 / 0));
  }
</style>

<script>
  type Pt = [number, number];

  const canvas = document.querySelector<HTMLCanvasElement>('[data-sphere]');
  const ctx = canvas?.getContext('2d');

  if (canvas && ctx) {
    const W = 1600;
    const H = 420;
    const CX = 800;
    const CY = 230;
    const traces: Pt[][] = JSON.parse(canvas.dataset.traces ?? '[]');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Points scattered evenly at random over a sphere, with a little depth so it feels organic.
    const N = 2400;
    const points = Array.from({ length: N }, () => {
      const y = Math.random() * 2 - 1;
      const r = Math.sqrt(1 - y * y);
      const phi = Math.random() * Math.PI * 2;
      const j = 1 - Math.random() * 0.06;
      return { x: Math.cos(phi) * r * j, y: y * j, z: Math.sin(phi) * r * j, accent: Math.random() < 0.05 };
    });

    // Each trace as a polyline with cumulative lengths, for moving dots along it.
    const paths = traces.map((pts) => {
      const lengths = [0];
      for (let i = 1; i < pts.length; i++) {
        lengths.push(lengths[i - 1] + Math.hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]));
      }
      return { pts, lengths, total: lengths[lengths.length - 1] };
    });
    const at = (p: (typeof paths)[number], f: number): Pt => {
      const target = f * p.total;
      let i = 1;
      while (i < p.lengths.length - 1 && p.lengths[i] < target) i++;
      const seg = p.lengths[i] - p.lengths[i - 1] || 1;
      const t = (target - p.lengths[i - 1]) / seg;
      const [x1, y1] = p.pts[i - 1];
      const [x2, y2] = p.pts[i];
      return [x1 + (x2 - x1) * t, y1 + (y2 - y1) * t];
    };
    const travellers = paths.flatMap((p, i) =>
      [0, 1].map((k) => ({ path: p, phase: (i * 0.137 + k / 2) % 1, speed: 1 / (7000 + (i % 5) * 900) })),
    );

    let w = 0;
    let h = 0;
    let scale = 1;
    let ox = 0;
    let oy = 0;
    let R = 150;
    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = canvas.clientWidth;
      h = canvas.clientHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      // Match the SVG's preserveAspectRatio="xMidYMid slice".
      scale = Math.max(w / W, h / H);
      ox = (w - W * scale) / 2;
      oy = (h - H * scale) / 2;
      R = Math.min(172, (w / scale) * 0.4);
    };

    const draw = (time: number) => {
      ctx.clearRect(0, 0, w, h);
      const cx = ox + CX * scale;
      const cy = oy + CY * scale;
      const r = R * scale;

      // The sphere
      const a = time * 0.00034;
      const tilt = 0.38 + Math.sin(time * 0.0004) * 0.12;
      const ca = Math.cos(a);
      const sa = Math.sin(a);
      const cb = Math.cos(tilt);
      const sb = Math.sin(tilt);
      for (const p of points) {
        const x1 = p.x * ca + p.z * sa;
        const z1 = -p.x * sa + p.z * ca;
        const y2 = p.y * cb - z1 * sb;
        const z2 = p.y * sb + z1 * cb;
        const depth = (z2 + 1) / 2; // 0 = back, 1 = front
        const persp = 1 / (1.6 - z2 * 0.35);
        const px = cx + x1 * r * persp * 1.6;
        const py = cy + y2 * r * persp * 1.6;
        const size = 0.8 + depth * 1.3;
        ctx.globalAlpha = 0.28 + depth * 0.62;
        ctx.fillStyle = p.accent ? '#000000' : '#555555';
        ctx.fillRect(px - size / 2, py - size / 2, size, size);
      }

      // Signals along the circuits: one small, soft dot per signal, drifting slowly outward
      // and fading in and out at the ends of the trace.
      const dot = Math.max(1.3, scale * 1.7);
      ctx.fillStyle = '#111111';
      for (const tr of travellers) {
        const f = (tr.phase + time * tr.speed) % 1;
        const fade = Math.sin(Math.PI * f);
        const [x, y] = at(tr.path, f);
        const px = ox + x * scale;
        const py = oy + y * scale;
        ctx.globalAlpha = fade * 0.08;
        ctx.beginPath();
        ctx.arc(px, py, dot * 3.2, 0, Math.PI * 2);
        ctx.fill();
        ctx.globalAlpha = fade * 0.55;
        ctx.beginPath();
        ctx.arc(px, py, dot, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalAlpha = 1;
    };

    let frame = 0;
    let running = false;
    const loop = (time: number) => {
      draw(time);
      if (running) frame = requestAnimationFrame(loop);
    };
    const start = () => {
      if (running || reduce) return;
      running = true;
      frame = requestAnimationFrame(loop);
    };
    const stop = () => {
      running = false;
      cancelAnimationFrame(frame);
    };

    resize();
    draw(0);
    new ResizeObserver(() => {
      resize();
      draw(performance.now());
    }).observe(canvas);
    new IntersectionObserver(([entry]) => (entry.isIntersecting ? start() : stop())).observe(canvas);
  }
</script>
